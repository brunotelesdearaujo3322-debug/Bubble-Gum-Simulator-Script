-- Loops automaticos (Blow Bubble / Auto Hatch) ---------------------------
local debugEnabled = false -- ligado pelo toggle "Debug" da aba Cliente

-- Cria um loop que so roda enquanto estiver ligado (e some no Kill Code)
local function makeLoop(step, getDelay)
	local thread
	local loop = {}

	function loop.Set(on)
		if on and not thread then
			thread = spawnTask(function()
				while alive do
					local ok, err = pcall(step)
					if not ok then
						warn("[SettingsGui] erro no loop:", err)
					end
					task.wait(getDelay())
				end
			end)
		elseif not on and thread then
			pcall(task.cancel, thread)
			thread = nil
		end
	end

	return loop
end

local remoteCache
local remoteWarned = false

local function getNetworkRemote()
	if remoteCache and remoteCache.Parent then
		return remoteCache
	end
	remoteCache = ReplicatedStorage:FindFirstChild("NetworkRemoteEvent")
		or ReplicatedStorage:FindFirstChild("NetworkRemoteEvent", true)
	return remoteCache
end

-- NetworkRemoteEvent:FireServer(...) com protecao; retorna ok, erro
local function fireNetwork(...)
	local remote = getNetworkRemote()
	if not remote then
		if not remoteWarned then
			remoteWarned = true
			warn("[SettingsGui] NetworkRemoteEvent nao encontrado em ReplicatedStorage")
		end
		return false, "NetworkRemoteEvent nao encontrado"
	end
	remoteWarned = false
	return pcall(remote.FireServer, remote, ...)
end

local blowBubbleDelay = BLOW_BUBBLE_DELAY
local blowBubbleLoop = makeLoop(function()
	fireNetwork("BlowBubble")
end, function()
	return blowBubbleDelay
end)

-- Collect all chests ---------------------------------------------------
-- Monta a rota de cada grupo de TELEPORT_GROUPS:
--   "Portal..."  -> entrada do mundo
--   "Retorno..." -> volta para o lobby
--   "Spawn..."   -> ignorado
--   o resto      -> baus (na ordem da lista)
-- Grupo com Portal e Retorno = mundo (entra, coleta, volta).
-- Grupo sem os dois (Lobby) = so teleporta para os baus.
local function buildChestRoutes()
	local routes = {}
	for _, group in ipairs(TELEPORT_GROUPS) do
		local route = { World = group.Title, Chests = {} }
		for _, loc in ipairs(group.Locations) do
			if loc.Nome:find("^Portal") then
				route.Portal = loc
			elseif loc.Nome:find("^Retorno") then
				route.Return = loc
			elseif not loc.Nome:find("^Spawn") then
				table.insert(route.Chests, loc)
			end
		end
		local isWorld = route.Portal ~= nil and route.Return ~= nil
		local isLobby = route.Portal == nil and route.Return == nil
		if (isWorld or isLobby) and #route.Chests > 0 then
			table.insert(routes, route)
		end
	end
	return routes
end

local function waitForRoot()
	for _ = 1, 50 do
		if getRoot() then
			return
		end
		task.wait(0.1)
	end
end

-- Vigia de recompensa ---------------------------------------------------
local function isWatched(name)
	if #WATCH_NAMES == 0 then
		return true
	end
	for _, wanted in ipairs(WATCH_NAMES) do
		if wanted:lower() == name:lower() then
			return true
		end
	end
	return false
end

-- Lista os valores numericos que valem a pena vigiar (e guarda o valor atual de cada um)
local function listWatchers()
	local watchers = {}

	local function add(name, read)
		local value = read()
		if type(value) == "number" and isWatched(name) then
			table.insert(watchers, { Name = name, Read = read, Start = value })
		end
	end

	for _, root in ipairs(WATCH_ROOTS) do
		for attrName in pairs(root:GetAttributes()) do
			add(attrName, function()
				return root:GetAttribute(attrName)
			end)
		end
		for _, inst in ipairs(root:GetDescendants()) do
			if (inst:IsA("IntValue") or inst:IsA("NumberValue")) and not inst:IsDescendantOf(playerGui) then
				add(inst.Name, function()
					return inst.Value
				end)
			end
		end
	end

	return watchers
end

-- Descarta valores que mudam sozinhos (timers, renda passiva) para nao dar falso positivo.
-- Se voce definiu WATCH_NAMES, confia nos nomes que escolheu e nao descarta nada.
local function buildWatchers()
	local watchers = listWatchers()
	if #WATCH_NAMES == 0 and #watchers > 0 then
		task.wait(CALIBRATE_TIME)
		local stable = {}
		for _, watcher in ipairs(watchers) do
			if watcher.Read() == watcher.Start then
				table.insert(stable, watcher)
			end
		end
		watchers = stable
	end
	return watchers
end

local function rebase(watchers)
	for _, watcher in ipairs(watchers) do
		local now = watcher.Read()
		if type(now) == "number" then
			watcher.Start = now
		end
	end
end

-- Retorna o nome e o quanto subiu, se algum valor vigiado aumentou
local function findIncrease(watchers)
	for _, watcher in ipairs(watchers) do
		local now = watcher.Read()
		if type(now) == "number" and now > watcher.Start then
			return watcher.Name, now - watcher.Start
		end
	end
	return nil
end

-- Timers dos baus ---------------------------------------------------------
-- O jogo mostra "Next Chest in:\nHH:MM:SS" em Workspace...Chest.Regen.Info.
-- Usamos isso para (1) pular baus em cooldown, (2) confirmar a coleta (o timer aparece)
-- e (3) saber quando o proximo bau fica pronto.

local function fmtTime(seconds)
	seconds = math.max(0, math.floor(seconds))
	local h = seconds // 3600
	local m = (seconds % 3600) // 60
	local sec = seconds % 60
	if h > 0 then
		return ("%d:%02d:%02d"):format(h, m, sec)
	end
	return ("%02d:%02d"):format(m, sec)
end

local function parseCountdown(text)
	local h, m, sec = text:match("(%d+):(%d+):(%d+)")
	if h then
		return tonumber(h) * 3600 + tonumber(m) * 60 + tonumber(sec)
	end
	local m2, s2 = text:match("(%d+):(%d+)")
	if m2 then
		return tonumber(m2) * 60 + tonumber(s2)
	end
	return nil
end

-- quando cada bau fica pronto (os.time). Fica em _G para sobreviver a re-execucao.
local chestReadyAt = _G.SettingsGuiChestTimers or {}
_G.SettingsGuiChestTimers = chestReadyAt

local function chestKey(chest)
	return game.JobId .. "|" .. chest.Nome
end

-- Registro dos timers que estao carregados no mapa agora (o jogo so carrega o que esta perto)
local timerLabels = {}

local function isTimerLabel(inst)
	if not inst:IsA("TextLabel") then
		return false
	end
	if inst.Name == "Info" and inst.Parent and inst.Parent.Name == "Regen" then
		return true
	end
	return inst.Text:find("Next Chest", 1, true) ~= nil
end

connect(workspace.DescendantAdded, function(inst)
	if isTimerLabel(inst) then
		timerLabels[inst] = true
	end
end)

spawnTask(function()
	local descendants = workspace:GetDescendants()
	for i, inst in ipairs(descendants) do
		if isTimerLabel(inst) then
			timerLabels[inst] = true
		end
		if i % 4000 == 0 then
			task.wait()
		end
	end
end)

local function labelPosition(label)
	local part = label:FindFirstAncestorWhichIsA("BasePart")
	if part then
		return part.Position
	end

	local billboard = label:FindFirstAncestorWhichIsA("BillboardGui")
	local adornee = billboard and billboard.Adornee
	if adornee then
		if adornee:IsA("BasePart") then
			return adornee.Position
		elseif adornee:IsA("Attachment") then
			return adornee.WorldPosition
		elseif adornee:IsA("Model") then
			return adornee:GetPivot().Position
		end
	end

	local model = label:FindFirstAncestorOfClass("Model")
	if model then
		return model:GetPivot().Position
	end
	return nil
end

-- o texto so conta se o timer esta realmente visivel (nenhum ancestral escondido/desligado)
local function isShown(label)
	local node = label
	while node and node ~= workspace do
		if node:IsA("GuiObject") and not node.Visible then
			return false
		end
		if node:IsA("LayerCollector") and not node.Enabled then
			return false
		end
		node = node.Parent
	end
	return true
end

-- "cooldown", segundos  |  "ready" (timer carregado, sem contagem)  |  nil (timer sumiu do mapa)
local function readLabel(label)
	if not label:IsDescendantOf(workspace) then
		return nil
	end
	local secs = parseCountdown(label.Text)
	if secs and secs > 0 and isShown(label) then
		return "cooldown", secs
	end
	return "ready"
end

-- acha o timer carregado que fica em cima do bau da lista (compara posicao)
local function findLabelFor(chest)
	for label in pairs(timerLabels) do
		if label:IsDescendantOf(workspace) then
			local pos = labelPosition(label)
			if pos then
				local d = pos - chest.Pos
				if math.abs(d.Y) <= TIMER_MATCH_Y and Vector3.new(d.X, 0, d.Z).Magnitude <= TIMER_MATCH_XZ then
					return label
				end
			end
		else
			timerLabels[label] = nil
		end
	end
	return nil
end

local function waitForLabel(chest, timeout)
	local deadline = os.clock() + timeout
	repeat
		local label = findLabelFor(chest)
		if label then
			return label
		end
		task.wait(0.15)
	until os.clock() >= deadline
	return nil
end

-- Situacao do bau: "cooldown", segundos | "ready" | "unknown"  (+ o timer, se estiver carregado)
-- So "cooldown" faz o script pular o bau; "ready" e "unknown" sempre tentam coletar.
local function chestStatus(chest)
	local label = findLabelFor(chest)
	if label then
		local state, secs = readLabel(label)
		if state == "cooldown" then
			chestReadyAt[chestKey(chest)] = os.time() + secs
			return "cooldown", secs, label
		elseif state == "ready" then
			chestReadyAt[chestKey(chest)] = nil
			return "ready", nil, label
		end
	end

	local readyAt = chestReadyAt[chestKey(chest)]
	if readyAt then
		local left = readyAt - os.time()
		if left > 0 then
			return "cooldown", left
		end
		chestReadyAt[chestKey(chest)] = nil
	end
	return "unknown"
end

-- Menor tempo restante entre os baus conhecidos (neste servidor)
local function nextChestReady()
	local now = os.time()
	local prefix = game.JobId .. "|"
	local bestSecs, bestName
	for key, readyAt in pairs(chestReadyAt) do
		local left = readyAt - now
		if left > 0 and key:sub(1, #prefix) == prefix and (not bestSecs or left < bestSecs) then
			bestSecs, bestName = left, key:sub(#prefix + 1)
		end
	end
	return bestSecs, bestName
end

-- Espera a confirmacao da coleta. Retorna "ok"/"cooldown" e uma nota, ou nil se nada aconteceu.
local function waitForCollected(chest, timerLabel, watchers, timeout)
	local deadline = os.clock() + timeout
	repeat
		local label = timerLabel or findLabelFor(chest)
		if label then
			local state, secs = readLabel(label)
			if state == "cooldown" then
				chestReadyAt[chestKey(chest)] = os.time() + secs
				if timerLabel then
					-- antes estava pronto e agora tem timer: coletou
					return "ok", "timer " .. fmtTime(secs)
				end
				-- o timer so carregou agora: nao da pra saber se coletamos ou se ja estava em cooldown
				local name, delta = findIncrease(watchers)
				if name then
					return "ok", ("+%.0f %s"):format(delta, name)
				end
				return "cooldown", fmtTime(secs)
			end
		end

		-- sem timer confiavel: confirma por Coins/Gems
		if not timerLabel then
			local name, delta = findIncrease(watchers)
			if name then
				return "ok", ("+%.0f %s"):format(delta, name)
			end
		end

		task.wait(0.1)
	until os.clock() >= deadline
	return nil
end

-- Verifica o timer, coleta e confirma.
-- Retorna "ok", "cooldown" (pulado), "fail" ou "unverified" e uma nota.
local function collectChest(chest, watchers, setStatus, label)
	-- 1) timer ja conhecido (carregado agora ou lido antes): pula se ainda esta em cooldown
	local status, secs, timerLabel = chestStatus(chest)
	if status == "cooldown" then
		return "cooldown", fmtTime(secs)
	end

	-- 2) timer ainda nao carregou: chega perto (sem encostar) so para carregar a area e ler o timer
	if not timerLabel then
		setStatus(label .. " - checking timer")
		waitForRoot()
		teleportTo(chest.Pos + Vector3.new(0, PRE_HOVER, 0))
		if waitForLabel(chest, STREAM_WAIT) then
			task.wait(LABEL_SETTLE)
			status, secs, timerLabel = chestStatus(chest)
			if status == "cooldown" then
				return "cooldown", fmtTime(secs)
			end
		end
	end

	-- 3) sem timer e sem valores para vigiar: so visita
	if not timerLabel and #watchers == 0 then
		waitForRoot()
		teleportTo(chest.Pos)
		task.wait(UNVERIFIED_DELAY)
		return "unverified", "sem timer e sem valores para vigiar"
	end

	-- 4) coleta e confirma
	for attempt = 1, CHEST_ATTEMPTS do
		if attempt > 1 then
			setStatus(("%s - try %d/%d"):format(label, attempt, CHEST_ATTEMPTS))
		end

		rebase(watchers)
		waitForRoot()
		teleportTo(chest.Pos)

		local outcome, note = waitForCollected(chest, timerLabel, watchers, CHEST_TIMEOUT)
		if outcome then
			task.wait(CHEST_AFTER_DELAY)
			return outcome, note
		end

		-- sem confirmacao: sobe um pouco e cai de volta no bau (re-dispara o toque) na proxima tentativa
		if attempt < CHEST_ATTEMPTS then
			teleportTo(chest.Pos + Vector3.new(0, 10, 0))
			task.wait(0.5)
		end
	end

	return "fail", "sem confirmacao (timer/recompensa)"
end

-- Lobby (so baus) e depois cada mundo: Portal -> espera -> baus -> Retorno Lobby.
-- Baus em cooldown sao pulados, e mundos inteiros em cooldown nem sao visitados.
local function collectAllChests(setStatus)
	local routes = buildChestRoutes()

	setStatus("Reading values...")
	local watchers = buildWatchers()

	local names = {}
	for _, watcher in ipairs(watchers) do
		table.insert(names, watcher.Name)
	end
	if #watchers > 0 then
		print(("[SettingsGui] Vigiando %d valor(es): %s"):format(#watchers, table.concat(names, ", ")))
	end

	local collected, onCooldown, unverified = 0, 0, 0
	local failed = {}

	for index, route in ipairs(routes) do
		local prefix = ("%s (%d/%d)"):format(route.World, index, #routes)

		-- mundo inteiro em cooldown (timers ja conhecidos): nem entra
		local allCooling = true
		for _, chest in ipairs(route.Chests) do
			if chestStatus(chest) ~= "cooldown" then
				allCooling = false
				break
			end
		end
		if allCooling then
			onCooldown += #route.Chests
			print(("[SettingsGui] %s: todos os baus em cooldown, mundo pulado"):format(route.World))
			continue
		end

		if route.Portal then
			setStatus(prefix .. ": Portal")
			waitForRoot()
			teleportTo(route.Portal.Pos)
			task.wait(PORTAL_DELAY)
		end

		for _, chest in ipairs(route.Chests) do
			local label = prefix .. ": " .. chest.Nome
			setStatus(label)

			local result, note = collectChest(chest, watchers, setStatus, label)
			if result == "ok" then
				collected += 1
				print(("[SettingsGui] OK       %s (%s)"):format(chest.Nome, note))
			elseif result == "cooldown" then
				onCooldown += 1
				print(("[SettingsGui] COOLDOWN %s (%s)"):format(chest.Nome, note))
			elseif result == "unverified" then
				unverified += 1
				print(("[SettingsGui] ?        %s (%s)"):format(chest.Nome, note))
			else
				table.insert(failed, chest.Nome)
				warn(("[SettingsGui] FALHOU   %s (%s)"):format(chest.Nome, note))
			end
		end

		if route.Return then
			setStatus(prefix .. ": Retorno Lobby")
			waitForRoot()
			teleportTo(route.Return.Pos)
			task.wait(RETURN_DELAY)
		end
	end

	local parts = { ("%d ok"):format(collected) }
	if onCooldown > 0 then
		table.insert(parts, onCooldown .. " cooldown")
	end
	if unverified > 0 then
		table.insert(parts, unverified .. " unverified")
	end
	if #failed > 0 then
		table.insert(parts, #failed .. " failed")
		warn("[SettingsGui] Baus sem confirmacao: " .. table.concat(failed, ", "))
	end
	local nextSecs = nextChestReady()
	if nextSecs then
		table.insert(parts, "next " .. fmtTime(nextSecs))
	end
	return table.concat(parts, " | ")
end

-- Botao "Chest timers": mostra quando o proximo bau fica pronto e imprime os detalhes no F9
local function checkChestTimers()
	local counts = { cooldown = 0, ready = 0, unknown = 0 }
	local nextSecs, nextName

	for _, route in ipairs(buildChestRoutes()) do
		for _, chest in ipairs(route.Chests) do
			local status, secs = chestStatus(chest)
			counts[status] += 1
			if status == "cooldown" then
				print(("[SettingsGui] %-28s cooldown %s"):format(chest.Nome, fmtTime(secs)))
				if not nextSecs or secs < nextSecs then
					nextSecs, nextName = secs, chest.Nome
				end
			else
				print(("[SettingsGui] %-28s %s"):format(chest.Nome, status))
			end
		end
	end

	-- diagnostico: texto cru dos timers carregados agora (bom para ver como fica um bau disponivel)
	for label in pairs(timerLabels) do
		if label:IsDescendantOf(workspace) then
			print(("[SettingsGui] timer %s | text=%q | shown=%s"):format(
				label:GetFullName(), label.Text, tostring(isShown(label))
			))
		end
	end

	local text
	if nextSecs then
		text = ("Next: %s in %s"):format(nextName, fmtTime(nextSecs))
	elseif counts.ready > 0 then
		text = ("%d chest(s) ready now"):format(counts.ready)
	else
		text = "No timers loaded yet"
	end
	if counts.unknown > 0 then
		text = text .. (" | %d unknown"):format(counts.unknown)
	end
	return text
end

local collectThread = nil

local function stopCollecting()
	if collectThread then
		pcall(task.cancel, collectThread)
		collectThread = nil
	end
end

-- Auto Hatch ----------------------------------------------------------
local selectedEgg = DEFAULT_EGG
local eggNames = {} -- ovos conhecidos (ordenados)
local eggStands = {} -- nome -> lugar onde voce ficou ao abrir o ovo (gravado pelo Egg recorder)
local hatchDelay = HATCH_DELAY

local function addEggName(name)
	for _, existing in ipairs(eggNames) do
		if existing == name then
			return false
		end
	end
	table.insert(eggNames, name)
	return true
end

addEggName(DEFAULT_EGG)

-- mundo de cada ovo/caixa (lista EGG_WORLDS; os gravados depois entram pelo ponto mais perto)
local eggWorld = {}
for _, group in ipairs(EGG_WORLDS) do
	for _, name in ipairs(group.Names) do
		eggWorld[name] = group.World
		addEggName(name)
	end
end
table.sort(eggNames)

local function isCrateName(name)
	return type(name) == "string" and name:find("%s[Cc][Rr][Aa][Tt][Ee]$") ~= nil
end

-- ovos (" Egg") e caixas (" Crate") usam o mesmo remote (PurchaseEgg), mas sao coisas diferentes
local function isEggName(name)
	return type(name) == "string" and #name <= 40
		and (name:find("%s[Ee][Gg][Gg]$") ~= nil or isCrateName(name))
end

-- Se o servidor checar distancia ate o ovo, chega perto antes de comprar
-- grupo do Teleport (mundo) cujo ponto conhecido esta mais perto de pos
local function worldAt(pos)
	local bestGroup, bestDist
	for _, group in ipairs(TELEPORT_GROUPS) do
		for _, loc in ipairs(group.Locations) do
			local d = (loc.Pos - pos).Magnitude
			if not bestDist or d < bestDist then
				bestGroup, bestDist = group, d
			end
		end
	end
	return bestGroup
end

local function findSpotByPrefix(group, prefix)
	for _, loc in ipairs(group.Locations) do
		if loc.Nome:find("^" .. prefix) then
			return loc
		end
	end
	return nil
end

-- Se o ovo e de outro mundo: sai do mundo atual pelo Retorno e entra pelo Portal do mundo do ovo
local function enterWorldOf(egg)
	local targetTitle = eggWorld[egg]
	local root = getRoot()
	if not (HATCH_ENTER_WORLD and targetTitle and root) then
		return
	end

	local current = worldAt(root.Position)
	if not current or current.Title == targetTitle then
		return
	end

	local back = findSpotByPrefix(current, "Retorno")
	if back then
		teleportTo(back.Pos)
		task.wait(RETURN_DELAY)
	end

	for _, group in ipairs(TELEPORT_GROUPS) do
		if group.Title == targetTitle then
			local portal = findSpotByPrefix(group, "Portal")
			if portal then
				teleportTo(portal.Pos)
				task.wait(PORTAL_DELAY)
			end
		end
	end
end

local function goToEgg(egg)
	local pos = eggStands[egg] -- lugar onde voce ficou ao abrir o ovo (EGG_SPOTS / Egg recorder)
	local root = getRoot()
	if pos and root and (root.Position - pos).Magnitude > HATCH_GO_DISTANCE then
		enterWorldOf(egg)
		teleportTo(pos)
		task.wait(0.5)
	end
end

local autoHatchLoop = makeLoop(function()
	-- nao compra enquanto o "Collect all chests" esta teleportando
	if collectThread then
		return
	end

	local egg = selectedEgg
	if HATCH_GO_TO_EGG then
		goToEgg(egg)
	end

	local ok, err = fireNetwork("PurchaseEgg", egg, HATCH_FLAG)
	if debugEnabled then
		print(("[SettingsGui] PurchaseEgg %q %s -> %s"):format(egg, tostring(HATCH_FLAG), ok and "enviado" or tostring(err)))
	end
end, function()
	return hatchDelay
end)

-- Egg recorder ------------------------------------------------------------
-- Quando voce abre um ovo, grava o nome, os argumentos, onde voce estava e tudo que achar do ovo,
-- e copia para a area de transferencia (bloco EGG_SPOTS para colar na config).
-- Deteccao: (1) hook no FireServer do NetworkRemoteEvent, se o executor tiver hookmetamethod;
--           (2) ProximityPrompt do ovo; (3) botao "Mark egg here" (manual).
local eggRecords = {} -- nome -> { Name, Stand, Lines, Count }

-- o hook so e instalado uma vez por sessao (fica em _G para nao empilhar ao re-executar)
local eggHookState = _G.SettingsGuiHookState
if not eggHookState then
	eggHookState = { Installed = false, Handler = nil }
	_G.SettingsGuiHookState = eggHookState
end

local recorderEnabled = false
local recording = false
local lastRemoteCaptureAt = 0
local onEggRecorded = nil -- (UI) chamado depois de gravar um ovo
local onRecorderStatus = nil -- (UI) texto de status

local function setRecorderStatus(text)
	if onRecorderStatus then
		onRecorderStatus(text)
	end
end

local function fmtVector(v)
	return ("Vector3.new(%.4f, %.4f, %.4f)"):format(v.X, v.Y, v.Z)
end

local function fmtCFrame(cf)
	local parts = {}
	for _, n in ipairs({ cf:GetComponents() }) do
		table.insert(parts, ("%.4f"):format(n))
	end
	return "CFrame.new(" .. table.concat(parts, ", ") .. ")"
end

local function oneLine(text, maxLen)
	local s = tostring(text):gsub("%s+", " ")
	if #s > maxLen then
		s = s:sub(1, maxLen - 3) .. "..."
	end
	return s
end

local function fmtValue(v)
	local t = typeof(v)
	if t == "string" then
		return ("%q"):format(v)
	elseif t == "Instance" then
		return "<" .. v:GetFullName() .. ">"
	elseif t == "Vector3" then
		return fmtVector(v)
	elseif t == "table" then
		return "{...}"
	end
	return tostring(v)
end

local function copyText(text)
	local clip = setclipboard or toclipboard
	if clip then
		return (pcall(clip, text))
	end
	return false
end

-- Foto de todos os numeros do jogador (leaderstats, valores, atributos) para ver o que mudou ao abrir o ovo
local function numericSnapshot()
	local snap = {}
	for _, root in ipairs(WATCH_ROOTS) do
		for attrName, value in pairs(root:GetAttributes()) do
			if type(value) == "number" then
				snap["attr " .. attrName] = value
			end
		end
		for _, inst in ipairs(root:GetDescendants()) do
			if (inst:IsA("IntValue") or inst:IsA("NumberValue")) and not inst:IsDescendantOf(playerGui) then
				snap[inst:GetFullName()] = inst.Value
			end
		end
	end
	return snap
end

local function describeChanges(before, after)
	local changes = {}
	for key, old in pairs(before) do
		local new = after[key]
		if type(new) == "number" and new ~= old then
			table.insert(changes, { Key = key, Old = old, New = new })
		end
	end
	table.sort(changes, function(a, b)
		return math.abs(a.New - a.Old) > math.abs(b.New - b.Old)
	end)

	local parts = {}
	for i = 1, math.min(#changes, 6) do
		local change = changes[i]
		local shortKey = change.Key:match("[^%.]+$") or change.Key
		local delta = change.New - change.Old
		table.insert(parts, ("%s %s%.0f (%.0f -> %.0f)"):format(
			shortKey, delta >= 0 and "+" or "", delta, change.Old, change.New
		))
	end
	if #parts == 0 then
		return "no numeric change detected"
	end
	return table.concat(parts, "; ")
end

-- ponto conhecido (da lista do Teleport) mais perto de voce: diz em que mundo/regiao voce esta
local function nearestKnownSpot(pos)
	local bestName, bestGroup, bestDist
	for _, group in ipairs(TELEPORT_GROUPS) do
		for _, loc in ipairs(group.Locations) do
			local d = (loc.Pos - pos).Magnitude
			if not bestDist or d < bestDist then
				bestName, bestGroup, bestDist = loc.Nome, group.Title, d
			end
		end
	end
	return bestName, bestGroup, bestDist
end

local function eggObjectPosition(inst)
	if inst:IsA("Model") then
		return inst:GetPivot().Position
	elseif inst:IsA("BasePart") then
		return inst.Position
	end
	return nil
end

-- acha o objeto do ovo no Workspace mais perto de voce (nome exato; se nao achar, qualquer " Egg")
local function findEggInstance(name, origin)
	local exact, exactDist
	local any, anyDist

	for i, inst in ipairs(workspace:GetDescendants()) do
		if inst:IsA("Model") or inst:IsA("BasePart") then
			local isExact = name ~= nil and inst.Name == name
			if isExact or isEggName(inst.Name) then
				local pos = eggObjectPosition(inst)
				if pos then
					local d = (pos - origin).Magnitude
					if isExact then
						if not exactDist or d < exactDist then
							exact, exactDist = inst, d
						end
					elseif not anyDist or d < anyDist then
						any, anyDist = inst, d
					end
				end
			end
		end
		if i % 4000 == 0 then
			task.wait()
		end
	end

	return exact or any
end

-- tudo que da para ler do ovo: caminho, posicao, tamanho, atributos, prompts e textos (precos!)
local function describeEggObject(inst, origin)
	local lines = {}
	local pos = eggObjectPosition(inst)

	table.insert(lines, ("egg object: %s (%s)"):format(inst:GetFullName(), inst.ClassName))
	if pos then
		table.insert(lines, ("object position: %s | %.1f studs from you"):format(fmtVector(pos), (pos - origin).Magnitude))
	end

	local size = inst:IsA("Model") and inst:GetExtentsSize() or inst.Size
	table.insert(lines, "object size: " .. fmtVector(size))

	local attrs = {}
	for key, value in pairs(inst:GetAttributes()) do
		table.insert(attrs, ("%s=%s"):format(key, oneLine(fmtValue(value), 40)))
	end
	table.sort(attrs)
	if #attrs > 0 then
		table.insert(lines, "object attributes: " .. table.concat(attrs, ", "))
	end

	local interactions, texts, childAttrs = {}, {}, {}
	for _, d in ipairs(inst:GetDescendants()) do
		if d:IsA("ProximityPrompt") then
			table.insert(interactions, ("ProximityPrompt %q/%q key=%s hold=%.1f range=%.1f"):format(
				d.ActionText, d.ObjectText, d.KeyboardKeyCode.Name, d.HoldDuration, d.MaxActivationDistance
			))
		elseif d:IsA("ClickDetector") then
			table.insert(interactions, ("ClickDetector range=%.1f"):format(d.MaxActivationDistance))
		elseif (d:IsA("TextLabel") or d:IsA("TextButton")) and d.Text ~= "" and #texts < 12 then
			table.insert(texts, ("%q"):format(oneLine(d.Text, 40)))
		end

		for key, value in pairs(d:GetAttributes()) do
			if #childAttrs < 12 then
				table.insert(childAttrs, ("%s.%s=%s"):format(d.Name, key, oneLine(fmtValue(value), 30)))
			end
		end
	end
	if #interactions > 0 then
		table.insert(lines, "interaction: " .. table.concat(interactions, " | "))
	end
	if #texts > 0 then
		table.insert(lines, "texts on the egg: " .. table.concat(texts, " | "))
	end
	if #childAttrs > 0 then
		table.insert(lines, "child attributes: " .. table.concat(childAttrs, ", "))
	end

	local children = {}
	for _, child in ipairs(inst:GetChildren()) do
		if #children < 12 then
			table.insert(children, ("%s (%s)"):format(child.Name, child.ClassName))
		end
	end
	if #children > 0 then
		table.insert(lines, "children: " .. table.concat(children, ", "))
	end

	return lines
end

-- bloco "local EGG_SPOTS = { ... }" com todos os ovos gravados (pronto para colar na config)
local function buildEggSnippet()
	local names = {}
	for name in pairs(eggRecords) do
		table.insert(names, name)
	end
	table.sort(names)

	local out = {
		"-- Egg spots gravados pelo recorder (cole no lugar de EGG_SPOTS, no topo do script)",
		"local EGG_SPOTS = {",
	}
	for _, name in ipairs(names) do
		local record = eggRecords[name]
		for _, line in ipairs(record.Lines) do
			table.insert(out, "\t-- " .. line)
		end
		table.insert(out, ("\t[%q] = %s,"):format(name, fmtVector(record.Stand)))
		table.insert(out, "")
	end
	table.insert(out, "}")
	return table.concat(out, "\n")
end

-- ovos que voce ja colou em EGG_SPOTS
for name, pos in pairs(EGG_SPOTS) do
	if typeof(pos) == "Vector3" then
		addEggName(name)
		eggStands[name] = pos
		eggRecords[name] = { Name = name, Stand = pos, Lines = { "(carregado de EGG_SPOTS)" }, Count = 0 }
	end
end
table.sort(eggNames)

-- info = { Source = "remote"|"prompt"|"manual", Name = string?, Args = table.pack(...)? }
local function recordEgg(info)
	local root = getRoot()
	if not root then
		setRecorderStatus("No character")
		return
	end

	local stand = root.Position
	local cframe = root.CFrame
	local name = info.Name

	-- mesmo ovo, mesmo lugar: so conta (nao repete a busca pesada)
	local existing = name and eggRecords[name]
	if existing and existing.Count > 0 and (existing.Stand - stand).Magnitude < 10 then
		existing.Count += 1
		setRecorderStatus(("%s opened x%d"):format(name, existing.Count))
		return
	end

	if recording then
		return
	end
	recording = true

	local ok, err = pcall(function()
		local before = numericSnapshot()
		local inst = findEggInstance(name, stand)
		name = name or (inst and inst.Name)
		if not name then
			setRecorderStatus("No egg found near you")
			return
		end

		task.wait(EGG_CURRENCY_WAIT)
		local after = numericSnapshot()

		local lines = {}
		table.insert(lines, ("[%s] source: %s | PlaceId %d | JobId %s"):format(
			os.date("%Y-%m-%d %H:%M:%S"), info.Source, game.PlaceId, game.JobId ~= "" and game.JobId or "-"
		))

		if info.Args then
			local shown = {}
			for i = 1, info.Args.n do
				shown[i] = fmtValue(info.Args[i])
			end
			table.insert(lines, "FireServer args: " .. table.concat(shown, ", "))
		end

		table.insert(lines, "you stood at: " .. fmtVector(stand))
		table.insert(lines, "your cframe: " .. fmtCFrame(cframe))

		local spotName, groupName, spotDist = nearestKnownSpot(stand)
		if spotName then
			table.insert(lines, ("nearest known spot: %s [%s], %.1f studs"):format(spotName, groupName, spotDist))
		end

		if inst then
			for _, line in ipairs(describeEggObject(inst, stand)) do
				table.insert(lines, line)
			end
		else
			table.insert(lines, "egg object: not loaded in Workspace")
		end

		table.insert(lines, ("changes in %.1fs: %s"):format(EGG_CURRENCY_WAIT, describeChanges(before, after)))

		eggRecords[name] = { Name = name, Stand = stand, Lines = lines, Count = 1 }
		eggStands[name] = stand
		eggWorld[name] = eggWorld[name] or groupName
		addEggName(name)
		table.sort(eggNames)

		local snippet = buildEggSnippet()
		local copied = copyText(snippet)
		print("[SettingsGui] ovo gravado:\n" .. snippet)
		setRecorderStatus(("%s saved%s"):format(name, copied and " + copied" or " (see F9)"))

		if onEggRecorded then
			pcall(onEggRecorded, name)
		end
	end)

	recording = false
	if not ok then
		warn("[SettingsGui] erro ao gravar ovo:", err)
		setRecorderStatus("Error (see F9)")
	end
end

-- chamado pelo hook com os argumentos do FireServer (sem o "self")
local function onRemoteCall(...)
	if not recorderEnabled then
		return
	end
	local args = table.pack(...)
	if args[1] ~= "PurchaseEgg" then
		return
	end
	lastRemoteCaptureAt = os.clock()
	local name = type(args[2]) == "string" and args[2] or nil
	spawnTask(recordEgg, { Source = "remote", Name = name, Args = args })
end

-- Hook no __namecall: so repassa os argumentos do FireServer do NetworkRemoteEvent (o resto passa direto)
local function installEggHook(state)
	if state.Installed then
		return true
	end
	if not (hookmetamethod and getnamecallmethod) then
		return false
	end

	local ok = pcall(function()
		local original
		local wrap = newcclosure or function(fn)
			return fn
		end
		original = hookmetamethod(game, "__namecall", wrap(function(...)
			if getnamecallmethod() == "FireServer" then
				local handler = state.Handler
				if handler then
					local self = ...
					if typeof(self) == "Instance" and self.Name == "NetworkRemoteEvent"
						and not (checkcaller and checkcaller()) then
						task.defer(handler, select(2, ...))
					end
				end
			end
			return original(...)
		end))
	end)

	state.Installed = ok
	return ok
end

-- Plano B (sem hook): ProximityPrompt do ovo
connect(ProximityPromptService.PromptTriggered, function(prompt)
	if not recorderEnabled then
		return
	end

	local name
	local node = prompt
	while node and node ~= workspace do
		if isEggName(node.Name) then
			name = node.Name
			break
		end
		node = node.Parent
	end
	if not name and isEggName(prompt.ObjectText) then
		name = prompt.ObjectText
	end
	if not name then
		return
	end

	-- espera um pouco: se o hook pegar o FireServer, ele grava com os argumentos
	local startedAt = os.clock()
	delayTask(0.7, function()
		if lastRemoteCaptureAt < startedAt then
			recordEgg({ Source = "prompt", Name = name })
		end
	end)
end)

local function setRecorder(on)
	recorderEnabled = on
	if on then
		if EGG_RECORDER_USE_HOOK and installEggHook(eggHookState) then
			eggHookState.Handler = onRemoteCall
			setRecorderStatus("Hook active - open an egg")
		else
			eggHookState.Handler = nil
			setRecorderStatus("No hook - listening to egg prompts")
		end
	else
		eggHookState.Handler = nil
		setRecorderStatus("Recorder off")
	end
end

-- Kill Code: desconecta tudo, cancela todas as threads e remove a GUI -----
local function killCode()
	if not alive then
		return
	end
	alive = false

	for _, connection in ipairs(connections) do
		connection:Disconnect()
	end
	table.clear(connections)

	local current = coroutine.running()
	for _, thread in ipairs(threads) do
		if thread ~= current and coroutine.status(thread) ~= "dead" then
			pcall(task.cancel, thread)
		end
	end
	table.clear(threads)
	collectThread = nil

	eggHookState.Handler = nil -- o hook (se foi instalado) fica inerte
	player:SetAttribute("Debug", nil)
	if _G.SettingsGuiKill == killCode then
		_G.SettingsGuiKill = nil
	end
	gui:Destroy()
end

_G.SettingsGuiKill = killCode

-- Rejoin / Server Hop -------------------------------------------------
-- Obs: precisa de HTTP (game:HttpGet ou request/http_request de executor) para listar servidores,
-- e o TeleportService nao funciona dentro do Roblox Studio (so no jogo real).

local function httpGet(url)
	local ok, body = pcall(function()
		return game:HttpGet(url)
	end)
	if ok and type(body) == "string" and #body > 0 then
		return body
	end

	local req = (syn and syn.request) or http_request or request
	if req then
		local ok2, res = pcall(req, { Url = url, Method = "GET" })
		if ok2 and type(res) == "table" and res.Body then
			return res.Body
		end
	end
	return nil
end

-- sortOrder "Desc" = servidores mais cheios primeiro, "Asc" = mais vazios primeiro
local function findServer(sortOrder, onlyEmptiest)
	local url = ("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=%s&excludeFullGames=true&limit=100")
		:format(game.PlaceId, sortOrder)

	local body = httpGet(url)
	if not body then
		return nil
	end

	local ok, data = pcall(function()
		return HttpService:JSONDecode(body)
	end)
	if not ok or type(data) ~= "table" or type(data.data) ~= "table" then
		return nil
	end

	local candidates = {}
	for _, server in ipairs(data.data) do
		if server.id ~= game.JobId
			and type(server.playing) == "number"
			and type(server.maxPlayers) == "number"
			and server.playing < server.maxPlayers then
			table.insert(candidates, server)
		end
	end
	if #candidates == 0 then
		return nil
	end

	-- nos mais vazios, sorteia entre os 5 primeiros (evita todo mundo cair no mesmo servidor)
	local limit = onlyEmptiest and math.min(#candidates, 5) or #candidates
	return candidates[math.random(1, limit)]
end

local hopping = false

local function hop(button, idleText, sortOrder, onlyEmptiest)
	if hopping then
		return
	end
	hopping = true
	button.Text = "Wait..."

	local server = findServer(sortOrder, onlyEmptiest)
	if server then
		local ok = pcall(function()
			TeleportService:TeleportToPlaceInstance(game.PlaceId, server.id, player)
		end)
		if ok then
			-- se o teleporte falhar, libera o botao de novo depois de um tempo
			delayTask(10, function()
				hopping = false
				button.Text = idleText
			end)
			return
		end
	end

	button.Text = "Failed"
	task.wait(2)
	button.Text = idleText
	hopping = false
end

local function rejoin(button)
	if hopping then
		return
	end
	hopping = true
	button.Text = "Wait..."

	local ok = pcall(function()
		if #Players:GetPlayers() <= 1 then
			-- sozinho no servidor: sai e entra de novo (um servidor novo)
			player:Kick("\nRejoining...")
			task.wait()
			TeleportService:Teleport(game.PlaceId, player)
		else
			TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, player)
		end
	end)

	if not ok then
		button.Text = "Failed"
		task.wait(2)
	else
		task.wait(10)
	end
	button.Text = "Rejoin"
	hopping = false
end

