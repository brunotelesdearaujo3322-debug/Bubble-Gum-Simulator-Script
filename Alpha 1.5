-- recria a lista (depois de gravar um ovo): primeiro os OVOS, depois as CAIXAS, por mundo
local function rebuildEggList()
	for _, item in ipairs(eggRows) do
		item:Destroy()
	end
	table.clear(eggRows)
	table.clear(eggButtons)

	for _, kind in ipairs({ "Eggs", "Crates" }) do
		local wantCrates = kind == "Crates"
		for _, worldTitle in ipairs(eggWorldOrder()) do
			local names = {}
			for _, name in ipairs(eggNames) do
				if isCrateName(name) == wantCrates and (eggWorld[name] or "Other") == worldTitle then
					table.insert(names, name)
				end
			end

			if #names > 0 then
				table.insert(eggRows, addSection(eggPage, kind .. ": " .. worldTitle))
				for _, name in ipairs(names) do
					local button = addButton(eggPage, name, eggDesc(name), "Select", function()
						selectedEgg = name
						refreshEggButtons()
					end)
					table.insert(eggRows, button.Parent)
					eggButtons[name] = button
				end
			end
		end
	end

	refreshEggButtons()
end

