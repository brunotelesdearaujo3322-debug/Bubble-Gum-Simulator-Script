	blowBubble.Delay = v
end, 0.05, "bubbles.delay")

local chestGroup = addGroup(autofarmPage, "Baús", { Open = true, Key = "autofarm/chests" })

local COLLECT_DESC = "Saves start pos, equips by world, returns at end"
local AUTO_COLLECT_DESC = "Repeats the collection when chests are ready"
local collectButton
local autoCollectToggle
local autoCollectThread
local autoOwnsRun = false -- a coleta em andamento foi iniciada pelo AutoCollect?

local function resetCollectUi()
	collectButton.SetText("Collect")
	collectButton.SetDesc(COLLECT_DESC)
end

collectButton = addButton(chestGroup.Body, "Collect all chests", COLLECT_DESC, "Collect", function()
	-- clicou de novo enquanto roda: para na hora e retorna ao inicio
	if Chests.Thread then
		Chests.stop()
		resetCollectUi()
		return
	end

	collectButton.SetText("Stop")
	Chests.start(collectButton.SetDesc, function(summary)
		collectButton.SetText("Collect")
		collectButton.SetDesc(summary)
	end)
end)

-- AutoCollect Chest: roda a coleta, espera o proximo bau ficar pronto (timers conhecidos) e repete.
-- O Auto Hatch e o Blow Bubble se pausam enquanto a coleta roda, e voce volta para a posicao inicial no fim.
local function setAutoCollect(on)
	if on and not autoCollectThread then
		autoCollectThread = spawnTask(function()
			while alive do
				-- nunca roda duas coletas juntas: espera uma coleta manual terminar
				while Chests.Thread do
					task.wait(0.5)
				end

				autoOwnsRun = true
				collectButton.SetText("Stop")
				Chests.start(collectButton.SetDesc, function(summary)
					collectButton.SetText("Collect")
					collectButton.SetDesc(summary)
				end)
				while Chests.Thread do
					task.wait(0.5)
				end
				autoOwnsRun = false

				-- espera o proximo bau ficar pronto (com folga), entre o minimo e o maximo configurados
				local secs = Chests.nextReady()
				local waitTime = secs and (secs + Cfg.AutoCollectMargin) or Cfg.AutoCollectRetry
				waitTime = math.clamp(waitTime, Cfg.AutoCollectMinWait, Cfg.AutoCollectMaxWait)

				local untilTime = os.clock() + waitTime
				repeat
					autoCollectToggle.SetDesc(("Next run in %s"):format(Chests.fmtTime(untilTime - os.clock())))
					task.wait(1)
				until os.clock() >= untilTime
			end
		end)
	elseif not on and autoCollectThread then
		pcall(task.cancel, autoCollectThread)
		autoCollectThread = nil
		autoCollectToggle.SetDesc(AUTO_COLLECT_DESC)

		-- desligou no meio de uma coleta que ele mesmo iniciou: para e volta para a posicao inicial
		if autoOwnsRun and Chests.Thread then
			autoOwnsRun = false
			Chests.stop()
			resetCollectUi()
		end
	end
end

autoCollectToggle = addToggle(chestGroup.Body, "AutoCollect Chest", AUTO_COLLECT_DESC, false, setAutoCollect, "chests.auto")

local timersButton
timersButton = addButton(chestGroup.Body, "Chest timers", "Shows when the next chest is ready", "Check", function()
