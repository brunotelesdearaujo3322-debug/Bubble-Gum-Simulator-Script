-- ABAS
---------------------------------------------------------------------
local tabs = {}
local tabCount = 0

local function selectTab(name)
	for tabName, tab in pairs(tabs) do
		local active = tabName == name
		tab.Page.Visible = active
		TweenService:Create(tab.Button, TWEEN_FAST, {
			BackgroundColor3 = active and THEME.On or THEME.TabIdle,
		}):Play()
		tab.Border.Color = active and THEME.OnBorder or THEME.PanelBorder
	end
end

local function newTab(name)
	tabCount += 1

	local buttonBorder = border(THEME.PanelBorder, 3)
	local button = create("TextButton", {
		Name = "Tab_" .. name,
		Size = UDim2.fromOffset(125, 36),
		BackgroundColor3 = THEME.TabIdle,
		AutoButtonColor = false,
		Text = name,
		Font = THEME.Font,
		TextSize = 22,
		TextColor3 = Color3.new(1, 1, 1),
		LayoutOrder = tabCount,
		Parent = tabBar,
	}, { corner(10), textStroke(2), buttonBorder })

	local page = create("ScrollingFrame", {
		Name = "Page_" .. name,
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = THEME.RowBorder,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Visible = false,
		Parent = content,
	}, {
		create("UIListLayout", {
			Padding = UDim.new(0, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
		create("UIPadding", {
			PaddingTop = UDim.new(0, 10),
			PaddingBottom = UDim.new(0, 10),
			PaddingLeft = UDim.new(0, 10),
			PaddingRight = UDim.new(0, 14),
		}),
	})

	tabs[name] = { Button = button, Page = page, Border = buttonBorder }
	button.Activated:Connect(function()
		selectTab(name)
	end)

	return page
end

---------------------------------------------------------------------
-- COMPONENTES
-- "parent" pode ser uma aba (newTab) ou o .Body de um grupo (addGroup)
---------------------------------------------------------------------
local function setRowDesc(row, text)
	local desc = row:FindFirstChild("Desc")
	if desc then
		desc.Text = text
	end
end

local function addSection(parent, text)
	return newLabel({
		Name = "Section_" .. text,
		Text = text,
		TextSize = 24,
		Size = UDim2.new(1, 0, 0, 30),
		LayoutOrder = nextOrder(parent),
		Parent = parent,
	}, 2)
end

-- linha base (titulo + descricao); "reserve" = espaco a direita para o controle
local function baseRow(parent, name, desc, reserve)
	local hasDesc = desc ~= nil and desc ~= ""

	local row = create("Frame", {
		Name = "Row_" .. name,
		Size = UDim2.new(1, 0, 0, hasDesc and 60 or 50),
		BackgroundColor3 = THEME.Row,
		LayoutOrder = nextOrder(parent),
		Parent = parent,
	}, { corner(8), border(THEME.RowBorder, 2) })

	newLabel({
		Name = "Title",
		Text = name,
		TextSize = 22,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Position = UDim2.fromOffset(12, hasDesc and 4 or 0),
		Size = hasDesc and UDim2.new(1, -reserve, 0, 28) or UDim2.new(1, -reserve, 1, 0),
		Parent = row,
	}, 2)

	if hasDesc then
		newLabel({
			Name = "Desc",
			Text = desc,
			TextSize = 15,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Position = UDim2.fromOffset(12, 32),
			Size = UDim2.new(1, -reserve, 0, 20),
			Parent = row,
		}, 1.5)
	end

	return row
end

-- GRUPO QUE ABRE E FECHA --------------------------------------------
-- Cabecalho clicavel + corpo (.Body) onde ficam os componentes.
-- opts.Open = comeca aberto?  opts.Key = id para lembrar o estado quando a lista e recriada
local groupOpenState = {} -- chave -> aberto?
local pageGroups = {} -- parent -> lista de grupos (para "Expandir/Recolher tudo")

-- configuracao salva: restaura quais grupos estavam abertos (antes de criar qualquer grupo)
Settings.Data = Cfg.AutoLoadConfig and Settings.read() or nil
if Settings.Data and type(Settings.Data.Groups) == "table" then
	for key, open in pairs(Settings.Data.Groups) do
		if type(open) == "boolean" then
			groupOpenState[key] = open
		end
	end
end

local function addGroup(parent, title, opts)
	opts = opts or {}
	local key = opts.Key or (parent.Name .. "/" .. title)
	local open = groupOpenState[key]
	if open == nil then
		open = opts.Open == true
	end
	groupOpenState[key] = open

	local holder = create("Frame", {
		Name = "Group_" .. title,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = nextOrder(parent),
		Parent = parent,
	}, {
		create("UIListLayout", {
			Padding = UDim.new(0, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})

	local header = create("TextButton", {
		Name = "Header",
		Size = UDim2.new(1, 0, 0, 40),
		BackgroundColor3 = THEME.TabIdle,
		AutoButtonColor = false,
		Text = "",
		LayoutOrder = 0,
		Parent = holder,
	}, { corner(10), border(THEME.PanelBorder, 3) })

	local arrow = newLabel({
		Name = "Arrow",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, 22, 0.5, 0),
		Size = UDim2.fromOffset(24, 24),
		Text = ">",
		TextSize = 24,
		Rotation = open and 90 or 0,
		Parent = header,
	}, 2)

	newLabel({
		Name = "Title",
		Text = title,
		TextSize = 22,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Position = UDim2.fromOffset(42, 0),
		Size = UDim2.new(1, -52, 1, 0),
		Parent = header,
	}, 2)

	local body = create("Frame", {
		Name = "Body",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Visible = open,
		LayoutOrder = 1,
		Parent = holder,
	}, {
		create("UIListLayout", {
			Padding = UDim.new(0, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
		create("UIPadding", { PaddingLeft = UDim.new(0, 12) }),
	})

	local group = { Holder = holder, Body = body, Header = header }

	function group.Set(newOpen)
		open = newOpen == true
		groupOpenState[key] = open
		body.Visible = open
		TweenService:Create(arrow, TWEEN_FAST, { Rotation = open and 90 or 0 }):Play()
	end

	function group.IsOpen()
		return open
	end

	function group.Destroy()
		local list = pageGroups[parent]
		local index = list and table.find(list, group)
		if index then
			table.remove(list, index)
		end
		holder:Destroy()
	end

	header.Activated:Connect(function()
		group.Set(not open)
	end)

	pageGroups[parent] = pageGroups[parent] or {}
	table.insert(pageGroups[parent], group)

	return group
end

local function setAllGroups(parent, open)
	for _, group in ipairs(pageGroups[parent] or {}) do
		group.Set(open)
		setAllGroups(group.Body, open) -- subgrupos
	end
end

-- linha com os botoes "Expandir tudo" / "Recolher tudo" para as abas com muitos grupos
local function addExpandControls(page)
	local row = create("Frame", {
		Name = "ExpandControls",
		Size = UDim2.new(1, 0, 0, 38),
		BackgroundTransparency = 1,
		LayoutOrder = nextOrder(page),
		Parent = page,
	}, {
		create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})

	local function makeButton(text, order, open)
		local button = create("TextButton", {
			Name = "Expand_" .. order,
			Size = UDim2.new(0.5, -4, 1, 0),
			BackgroundColor3 = THEME.On,
			Text = text,
			Font = THEME.Font,
			TextSize = 20,
			TextColor3 = Color3.new(1, 1, 1),
			LayoutOrder = order,
			Parent = row,
		}, { corner(8), border(THEME.OnBorder, 2), textStroke(2, THEME.OnBorder) })
		button.Activated:Connect(function()
			setAllGroups(page, open)
		end)
	end

	makeButton("Expandir tudo", 1, true)
	makeButton("Recolher tudo", 2, false)
end

local function addToggle(parent, name, desc, default, callback, key)
	local row = baseRow(parent, name, desc, 90)
	local state = default == true

	local OFF_POS = UDim2.new(0, 3, 0.5, 0)
	local ON_POS = UDim2.new(1, -29, 0.5, 0)

	local trackStroke = border(state and THEME.OnBorder or THEME.KnobBorder, 2)
	local track = create("TextButton", {
		Name = "Track",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.fromOffset(64, 30),
		BackgroundColor3 = state and THEME.On or THEME.Off,
		AutoButtonColor = false,
		Text = "",
		Parent = row,
	}, { pill(), trackStroke })

	local knob = create("Frame", {
		Name = "Knob",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = state and ON_POS or OFF_POS,
		Size = UDim2.fromOffset(26, 26),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Parent = track,
	}, { pill(), border(THEME.KnobBorder, 2) })

	local function apply(newState, silent)
		state = newState
		TweenService:Create(track, TWEEN_FAST, {
			BackgroundColor3 = state and THEME.On or THEME.Off,
		}):Play()
		TweenService:Create(knob, TWEEN_FAST, {
			Position = state and ON_POS or OFF_POS,
		}):Play()
		trackStroke.Color = state and THEME.OnBorder or THEME.KnobBorder
		if callback and not silent then
			spawnTask(callback, state)
		end
	end

	track.Activated:Connect(function()
		apply(not state)
	end)

	local handle = {
		Row = row,
		Set = function(value, silent)
			apply(value == true, silent)
		end,
		Get = function()
			return state
		end,
		SetDesc = function(text)
			setRowDesc(row, text)
		end,
	}
	if key then
		Settings.Controls[key] = { Kind = "toggle", Handle = handle }
	end
	return handle
end

-- o ScrollingFrame da aba (para travar o scroll enquanto arrasta um slider)
local function scrollerOf(parent)
	if parent:IsA("ScrollingFrame") then
		return parent
	end
	return parent:FindFirstAncestorOfClass("ScrollingFrame")
end

-- um unico par de conexoes globais serve para todos os sliders
local activeSlider -- { Update = fn, Parent = parent do slider }

connect(UserInputService.InputChanged, function(input)
	if activeSlider and isMotion(input) then
		activeSlider.Update(input)
	end
end)

connect(UserInputService.InputEnded, function(input)
	if activeSlider and isPointer(input) then
		local scroller = scrollerOf(activeSlider.Parent)
		if scroller then
			scroller.ScrollingEnabled = true
		end
		activeSlider = nil
	end
end)

local function addSlider(parent, name, desc, min, max, default, callback, step, key)
	step = step or 1
	local row = baseRow(parent, name, desc, 270)
	local value -- nil ate o primeiro setValue (garante que a UI seja desenhada)

	local track = create("Frame", {
		Name = "Track",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -24, 0.5, 0),
		Size = UDim2.fromOffset(170, 16),
		BackgroundColor3 = THEME.Track,
		Parent = row,
	}, { pill(), border(THEME.KnobBorder, 2) })

	local fill = create("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = THEME.On,
		Parent = track,
	}, { pill() })

	local knob = create("Frame", {
		Name = "Knob",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.fromOffset(30, 30),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 2,
		Parent = track,
	}, { pill(), border(THEME.KnobBorder, 2) })

	local valueLabel = newLabel({
		Name = "Value",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -214, 0.5, 0),
		Size = UDim2.fromOffset(44, 24),
		TextSize = 18,
		TextXAlignment = Enum.TextXAlignment.Right,
		Text = "",
		Parent = row,
	}, 1.5)

	local function setValue(v, silent)
		v = math.clamp(min + math.round((v - min) / step) * step, min, max)
		v = tonumber(string.format("%.4f", v)) -- remove o ruido de ponto flutuante (0.15000000000000002)
		if v == value then
			return -- sem mudanca: nao redesenha nem dispara o callback
		end
		value = v

		local alpha = max > min and (v - min) / (max - min) or 0
		fill.Size = UDim2.fromScale(alpha, 1)
		knob.Position = UDim2.new(alpha, 0, 0.5, 0)
		valueLabel.Text = tostring(v)

		if callback and not silent then
			spawnTask(callback, v)
		end
	end

	local function updateFromInput(input)
		local alpha = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
		setValue(min + alpha * (max - min))
	end

	local hit = create("TextButton", {
		Name = "Hit",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, 30, 0, 36),
		BackgroundTransparency = 1,
		Text = "",
		ZIndex = 3,
		Parent = track,
	})

	hit.InputBegan:Connect(function(input)
		if isPointer(input) then
			activeSlider = { Update = updateFromInput, Parent = parent }
			-- trava o scroll da aba enquanto arrasta o slider
			local scroller = scrollerOf(parent)
			if scroller then
				scroller.ScrollingEnabled = false
			end
			updateFromInput(input)
		end
	end)

	setValue(default, true)

	local handle = {
		Row = row,
		Set = function(v, silent)
			setValue(v, silent)
		end,
		Get = function()
			return value
		end,
		SetDesc = function(text)
			setRowDesc(row, text)
		end,
	}
	if key then
		Settings.Controls[key] = { Kind = "slider", Handle = handle }
	end
	return handle
end

local function addButton(parent, name, desc, buttonText, callback)
	local row = baseRow(parent, name, desc, 130)

	local frameStroke = border(THEME.OnBorder, 2)
	local textOutline = textStroke(2, THEME.OnBorder)
	local button = create("TextButton", {
		Name = "Action",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.fromOffset(96, 34),
		BackgroundColor3 = THEME.On,
		Text = buttonText,
		Font = THEME.Font,
		TextSize = 20,
		TextColor3 = Color3.new(1, 1, 1),
		Parent = row,
	}, { corner(8), frameStroke, textOutline })

	button.Activated:Connect(function()
		if callback then
			spawnTask(callback)
		end
	end)

	return {
		Row = row,
		Button = button,
		SetText = function(text)
			button.Text = text
		end,
		SetDesc = function(text)
			setRowDesc(row, text)
		end,
		-- cor do fundo e da borda/contorno do botao
		SetStyle = function(fillColor, strokeColor)
			button.BackgroundColor3 = fillColor
			frameStroke.Color = strokeColor
			textOutline.Color = strokeColor
		end,
	}
end

---------------------------------------------------------------------
-- LOGICA: personagem
---------------------------------------------------------------------
local saved = {} -- valores escolhidos pelo jogador (reaplicados ao respawnar)

local function getHumanoid()
	local char = player.Character
	return char and char:FindFirstChildOfClass("Humanoid")
end

local function getRoot()
	local char = player.Character
	return char and char:FindFirstChild("HumanoidRootPart")
end

-- espera o personagem existir; retorna false se nao apareceu em ~5s
local function waitForRoot()
	for _ = 1, 50 do
		if getRoot() then
			return true
		end
		task.wait(0.1)
	end
	return false
end

local function teleportTo(position)
	local root = getRoot()
	if not root then
		return false
	end
	root.AssemblyLinearVelocity = Vector3.zero -- nao herda a velocidade de queda
	root.AssemblyAngularVelocity = Vector3.zero
	root.CFrame = CFrame.new(position)
	return true
end

local function teleportCFrame(cf)
	local root = getRoot()
	if not root or not cf then
		return false
	end
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
	root.CFrame = cf
	return true
end

-- espera o personagem e teleporta; sem personagem, aborta a rotina (quem chama roda dentro de pcall)
local function goTo(position)
	if not waitForRoot() then
		error("sem personagem", 0)
	end
	teleportTo(position)
end

local function applyCharacterSettings(char)
	local hum = char:WaitForChild("Humanoid", 5)
	if not hum then
		return
	end
	if saved.WalkSpeed then
		hum.WalkSpeed = saved.WalkSpeed
	end
	if saved.JumpPower then
		hum.UseJumpPower = true
		hum.JumpPower = saved.JumpPower
	end
end

connect(player.CharacterAdded, applyCharacterSettings)

---------------------------------------------------------------------
-- LOGICA: loops automaticos e rede
---------------------------------------------------------------------
local debugEnabled = false -- ligado pelo toggle "Debug" da aba Cliente

-- Cria um loop que so roda enquanto estiver ligado (e some no Kill Code)
local function makeLoop(step, getDelay)
	local thread
	local loop = {}

	function loop.Set(on)
		if on and not thread then
			thread = spawnTask(function()
				while alive do
					local ok, err = pcall(step)
					if not ok then
						warn("[SettingsGui] erro no loop:", err)
					end
					task.wait(getDelay())
				end
			end)
		elseif not on and thread then
			pcall(task.cancel, thread)
			thread = nil
		end
	end

	return loop
end

local Net = { Remote = nil, Warned = false }

function Net.getRemote()
	if Net.Remote and Net.Remote.Parent then
		return Net.Remote
	end
	Net.Remote = ReplicatedStorage:FindFirstChild("NetworkRemoteEvent")
		or ReplicatedStorage:FindFirstChild("NetworkRemoteEvent", true)
	return Net.Remote
end

-- NetworkRemoteEvent:FireServer(...) com protecao; retorna ok, erro
function Net.fire(...)
	local remote = Net.getRemote()
	if not remote then
		if not Net.Warned then
			Net.Warned = true
			warn("[SettingsGui] NetworkRemoteEvent nao encontrado em ReplicatedStorage")
		end
		return false, "NetworkRemoteEvent nao encontrado"
	end
	Net.Warned = false
	return pcall(remote.FireServer, remote, ...)
end

---------------------------------------------------------------------
-- LOGICA: equipes por mundo
---------------------------------------------------------------------
local Teams = { LastSlot = nil }

function Teams.slotForWorld(worldName)
	if worldName == "Lobby" then
		return Cfg.LobbyTeam
	elseif worldName == "Céu" then
		return Cfg.SkyWorldTeam
	end
	return Cfg.DefaultWorldTeam
end

function Teams.equipSlot(slot)
	if not Cfg.AutoEquipTeams or type(slot) ~= "number" then
		return
	end
	if Teams.LastSlot == slot then
		return
	end
	local ok, err = Net.fire("EquipTeam", slot)
	if ok then
		Teams.LastSlot = slot
		if debugEnabled then
			print(("[SettingsGui] EquipTeam %d"):format(slot))
		end
		if Cfg.EquipTeamDelay > 0 then
			task.wait(Cfg.EquipTeamDelay)
		end
	elseif debugEnabled then
		warn(("[SettingsGui] Falha EquipTeam %d: %s"):format(slot, tostring(err)))
	end
end

function Teams.equipForWorld(worldName)
	Teams.equipSlot(Teams.slotForWorld(worldName))
end

---------------------------------------------------------------------
-- LOGICA: mundos (portais e retorno ao Lobby)
---------------------------------------------------------------------
-- O teleporte do Portal/Retorno e feito pelo servidor e leva um tempo. Aqui o script so continua depois
-- de CONFERIR que o personagem chegou (posicao no Lobby ou no mundo certo), em vez de esperar um tempo fixo.
local Worlds = {}

-- mundo em que o personagem esta agora, ou nil se nao ha personagem
function Worlds.current()
	local root = getRoot()
	return root and worldAt(root.Position) or nil
end

-- espera o personagem estar no mundo "title"
function Worlds.waitFor(title, timeout)
	local deadline = os.clock() + timeout
	repeat
		if Worlds.current() == title then
			return true
		end
		task.wait(0.2)
	until os.clock() >= deadline
	return false
end

-- Teleporta para um portal/retorno e so retorna true quando o personagem realmente chegou em "title".
-- Se nao chegou, teleporta de novo (Cfg.PortalAttempts); no fim espera fallbackDelay e confere uma ultima vez.
function Worlds.travel(spot, title, setStatus, text, fallbackDelay)
	for attempt = 1, Cfg.PortalAttempts do
		if attempt > 1 then
			setStatus(("%s - retry %d/%d"):format(text, attempt, Cfg.PortalAttempts))
		end
		goTo(spot.Pos)
		if Worlds.waitFor(title, Cfg.PortalArriveTimeout) then
			if debugEnabled then
				print(("[SettingsGui] %s: chegou em %s (tentativa %d)"):format(text, title, attempt))
			end
			task.wait(Cfg.WorldSettleDelay)
			return true
		end
	end

	setStatus(("%s - waiting %ds"):format(text, fallbackDelay))
	task.wait(fallbackDelay)
	local arrived = Worlds.current() == title
	if debugEnabled then
		print(("[SettingsGui] %s: sem confirmacao apos as tentativas; depois do delay %s em %s"):format(
			text, arrived and "chegou" or "NAO chegou", title
		))
	end
	return arrived
end

-- Garante que o personagem esta no Lobby: se estiver dentro de um mundo, usa o Retorno dele.
function Worlds.ensureLobby(setStatus)
	if not waitForRoot() then
		error("sem personagem", 0)
	end
	local world = Worlds.current()
	if world == "Lobby" then
		return true
	end
	local back = spotOf(world, "return")
	if not back then
		return false
	end
	setStatus("Returning to Lobby")
	return Worlds.travel(back, "Lobby", setStatus, "Retorno Lobby", Cfg.ReturnDelay)
end

-- Leva o personagem ao mundo "title": primeiro o Lobby, depois o Portal do mundo. true se chegou.
function Worlds.enter(title, setStatus)
	setStatus = setStatus or noop
	if not title then
		return false
	end
	if Worlds.current() == title then
		return true
	end
	if not Worlds.ensureLobby(setStatus) then
		return false
	end
	if title == "Lobby" then
		return true
	end
	local portal = spotOf(title, "portal")
	if not portal then
		return false
	end
	return Worlds.travel(portal, title, setStatus, "Portal " .. title, Cfg.PortalDelay)
end

---------------------------------------------------------------------
-- LOGICA: Collect all chests
---------------------------------------------------------------------
-- Rota: Lobby (so baus) e depois cada mundo: Portal -> espera -> baus -> Retorno Lobby.
-- Ao iniciar, grava a posicao atual e, ao encerrar, volta para ela.
-- Baus em cooldown sao pulados, e mundos inteiros em cooldown nem sao visitados.
-- Chests.Thread = a thread da coleta enquanto ela roda (os outros loops se pausam)
local Chests = { Thread = nil, StartCFrame = nil }

do
	local function buildRoutes()
		local routes = {}
		for _, group in ipairs(TELEPORT_GROUPS) do
			local route = { World = group.Title, Chests = {} }
			for _, loc in ipairs(group.Locations) do
				if loc.Kind == "portal" then
					route.Portal = loc
				elseif loc.Kind == "return" then
					route.Return = loc
				elseif loc.Kind == "chest" then
					table.insert(route.Chests, loc)
				end
			end
			local isWorld = route.Portal ~= nil and route.Return ~= nil
			local isLobby = route.Portal == nil and route.Return == nil
			if (isWorld or isLobby) and #route.Chests > 0 then
				table.insert(routes, route)
			end
		end
		return routes
	end

	-- Vigia de recompensa -------------------------------------------
	local function isWatched(name)
		if #Cfg.WatchNames == 0 then
			return true
		end
		for _, wanted in ipairs(Cfg.WatchNames) do
			if wanted:lower() == name:lower() then
				return true
			end
		end
		return false
	end

	-- lista os valores numericos que valem a pena vigiar (e guarda o valor atual de cada um)
	local function listWatchers()
		local watchers = {}
		eachNumericValue(function(name, _, read)
			local value = read()
			if type(value) == "number" and isWatched(name) then
				table.insert(watchers, { Name = name, Read = read, Start = value })
			end
		end)
		return watchers
	end

	-- Descarta valores que mudam sozinhos (timers, renda passiva) para nao dar falso positivo.
	-- Se voce definiu WatchNames, confia nos nomes que escolheu e nao descarta nada.
	local function buildWatchers()
		local watchers = listWatchers()
		if #Cfg.WatchNames == 0 and #watchers > 0 then
			task.wait(Cfg.CalibrateTime)
			local stable = {}
			for _, watcher in ipairs(watchers) do
				if watcher.Read() == watcher.Start then
					table.insert(stable, watcher)
				end
			end
			watchers = stable
		end
		return watchers
	end

	local function rebase(watchers)
		for _, watcher in ipairs(watchers) do
			local now = watcher.Read()
			if type(now) == "number" then
				watcher.Start = now
			end
		end
	end

	-- retorna o nome e o quanto subiu, se algum valor vigiado aumentou
	local function findIncrease(watchers)
		for _, watcher in ipairs(watchers) do
			local now = watcher.Read()
			if type(now) == "number" and now > watcher.Start then
				return watcher.Name, now - watcher.Start
			end
		end
		return nil
	end

	-- Timers dos baus -----------------------------------------------
	-- O jogo mostra "Next Chest in:\nHH:MM:SS" em Workspace...Chest.Regen.Info.
	-- Usamos isso para (1) pular baus em cooldown, (2) confirmar a coleta (o timer aparece)
	-- e (3) saber quando o proximo bau fica pronto.
	local function fmtTime(seconds)
		seconds = math.max(0, math.floor(seconds))
		local h = seconds // 3600
		local m = (seconds % 3600) // 60
		local s = seconds % 60
		if h > 0 then
			return ("%d:%02d:%02d"):format(h, m, s)
		end
		return ("%02d:%02d"):format(m, s)
	end

	local function parseCountdown(text)
		local h, m, s = text:match("(%d+):(%d+):(%d+)")
		if h then
			return tonumber(h) * 3600 + tonumber(m) * 60 + tonumber(s)
		end
		local m2, s2 = text:match("(%d+):(%d+)")
		if m2 then
			return tonumber(m2) * 60 + tonumber(s2)
		end
		return nil
	end

	-- quando cada bau fica pronto (os.time). Fica em _G para sobreviver a re-execucao.
	local readyAt = _G.SettingsGuiChestTimers or {}
	_G.SettingsGuiChestTimers = readyAt
	do
		local now = os.time()
		for key, at in pairs(readyAt) do
			if at <= now then
				readyAt[key] = nil -- poda timers vencidos
			end
		end
	end

	local function chestKey(chest)
		return game.JobId .. "|" .. chest.Name
	end

	-- Registro dos timers carregados no mapa agora (o jogo so carrega o que esta perto).
	-- Tabela fraca: timers destruidos pelo streaming saem sozinhos.
	local timerLabels = setmetatable({}, { __mode = "k" })

	local function isTimerLabel(inst)
		if not inst:IsA("TextLabel") then
			return false
		end
		if inst.Name == "Info" and inst.Parent and inst.Parent.Name == "Regen" then
			return true
		end
		return inst.Text:find("Next Chest", 1, true) ~= nil
	end

	connect(workspace.DescendantAdded, function(inst)
		if isTimerLabel(inst) then
			timerLabels[inst] = true
		end
	end)

	spawnTask(function()
		local descendants = workspace:GetDescendants()
		for i, inst in ipairs(descendants) do
			if isTimerLabel(inst) then
				timerLabels[inst] = true
			end
			if i % 4000 == 0 then
				task.wait()
			end
		end
	end)

	local function labelPosition(timerLabel)
		local part = timerLabel:FindFirstAncestorWhichIsA("BasePart")
		if part then
			return part.Position
		end

		local billboard = timerLabel:FindFirstAncestorWhichIsA("BillboardGui")
		local adornee = billboard and billboard.Adornee
		if adornee then
			if adornee:IsA("BasePart") then
				return adornee.Position
			elseif adornee:IsA("Attachment") then
				return adornee.WorldPosition
			elseif adornee:IsA("Model") then
				return adornee:GetPivot().Position
			end
		end

		local model = timerLabel:FindFirstAncestorOfClass("Model")
		if model then
			return model:GetPivot().Position
		end
		return nil
	end

	-- o texto so conta se o timer esta realmente visivel (nenhum ancestral escondido/desligado)
	local function isShown(timerLabel)
		local node = timerLabel
		while node and node ~= workspace do
			if node:IsA("GuiObject") and not node.Visible then
				return false
			end
			if node:IsA("LayerCollector") and not node.Enabled then
				return false
			end
			node = node.Parent
		end
		return true
	end

	-- "cooldown", segundos  |  "ready" (timer carregado, sem contagem)  |  nil (timer sumiu do mapa)
	local function readLabel(timerLabel)
		if not timerLabel:IsDescendantOf(workspace) then
			return nil
		end
		local secs = parseCountdown(timerLabel.Text)
		if secs and secs > 0 and isShown(timerLabel) then
			return "cooldown", secs
		end
		return "ready"
	end

	-- acha o timer carregado que fica em cima do bau da lista (compara posicao)
	local function findLabelFor(chest)
		for timerLabel in pairs(timerLabels) do
			if timerLabel:IsDescendantOf(workspace) then
				local pos = labelPosition(timerLabel)
				if pos then
					local d = pos - chest.Pos
					if math.abs(d.Y) <= Cfg.TimerMatchY and Vector3.new(d.X, 0, d.Z).Magnitude <= Cfg.TimerMatchXZ then
						return timerLabel
					end
				end
			else
				timerLabels[timerLabel] = nil
			end
		end
		return nil
	end

	local function waitForLabel(chest, timeout)
		local deadline = os.clock() + timeout
		repeat
			local timerLabel = findLabelFor(chest)
			if timerLabel then
				return timerLabel
			end
			task.wait(Cfg.ChestPoll)
		until os.clock() >= deadline
		return nil
	end

	-- Situacao do bau: "cooldown", segundos | "ready" | "unknown"  (+ o timer, se estiver carregado)
	-- So "cooldown" faz o script pular o bau; "ready" e "unknown" sempre tentam coletar.
	local function chestStatus(chest)
		local timerLabel = findLabelFor(chest)
		if timerLabel then
			local state, secs = readLabel(timerLabel)
			if state == "cooldown" then
				readyAt[chestKey(chest)] = os.time() + secs
				return "cooldown", secs, timerLabel
			elseif state == "ready" then
				readyAt[chestKey(chest)] = nil
				return "ready", nil, timerLabel
			end
		end

		local at = readyAt[chestKey(chest)]
		if at then
			local left = at - os.time()
			if left > 0 then
				return "cooldown", left
			end
			readyAt[chestKey(chest)] = nil
		end
		return "unknown"
	end

	-- menor tempo restante entre os baus conhecidos (neste servidor)
	local function nextChestReady()
		local now = os.time()
		local prefix = game.JobId .. "|"
		local bestSecs, bestName
		for key, at in pairs(readyAt) do
			local left = at - now
			if left > 0 and key:sub(1, #prefix) == prefix and (not bestSecs or left < bestSecs) then
				bestSecs, bestName = left, key:sub(#prefix + 1)
			end
		end
		return bestSecs, bestName
	end

	-- Espera a confirmacao da coleta. Retorna "ok"/"cooldown" e uma nota, ou nil se nada aconteceu.
	local function waitForCollected(chest, timerLabel, watchers, timeout)
		local deadline = os.clock() + timeout
		repeat
			local current = timerLabel or findLabelFor(chest)
			if current then
				local state, secs = readLabel(current)
				if state == "cooldown" then
					readyAt[chestKey(chest)] = os.time() + secs
					if timerLabel then
						-- antes estava pronto e agora tem timer: coletou
						return "ok", "timer " .. fmtTime(secs)
					end
					-- o timer so carregou agora: nao da pra saber se coletamos ou se ja estava em cooldown
					local name, delta = findIncrease(watchers)
					if name then
						return "ok", ("+%.0f %s"):format(delta, name)
					end
					return "cooldown", fmtTime(secs)
				end
			end

			-- sem timer confiavel: confirma por Coins/Gems
			if not timerLabel then
				local name, delta = findIncrease(watchers)
				if name then
					return "ok", ("+%.0f %s"):format(delta, name)
				end
			end

			task.wait(Cfg.ChestPoll)
		until os.clock() >= deadline
		return nil
	end

	-- Verifica o timer, coleta e confirma.
	-- Retorna "ok", "cooldown" (pulado), "fail" ou "unverified" e uma nota.
	local function collectChest(chest, watchers, setStatus, text, worldTitle)
		-- se o personagem saiu do mundo do bau (ex.: morreu e renasceu no Lobby), nao teleporta para as
		-- coordenadas do bau: devolve "left" e quem chamou volta a entrar no mundo antes de tentar de novo
		local function leftWorld()
			return worldTitle ~= nil and Worlds.current() ~= worldTitle
		end

		-- 1) timer ja conhecido (carregado agora ou lido antes): pula se ainda esta em cooldown
		local status, secs, timerLabel = chestStatus(chest)
		if status == "cooldown" then
			return "cooldown", fmtTime(secs)
		end

		-- 2) timer ainda nao carregou: chega perto (sem encostar) so para carregar a area e ler o timer
		if not timerLabel then
			if leftWorld() then
				return "left", "saiu do mundo"
			end
			setStatus(text .. " - checking timer")
			goTo(chest.Pos + Vector3.new(0, Cfg.PreHover, 0))
			if waitForLabel(chest, Cfg.StreamWait) then
				task.wait(Cfg.LabelSettle)
				status, secs, timerLabel = chestStatus(chest)
				if status == "cooldown" then
					return "cooldown", fmtTime(secs)
				end
			end
		end

		-- 3) sem timer e sem valores para vigiar: so visita
		if not timerLabel and #watchers == 0 then
			if leftWorld() then
				return "left", "saiu do mundo"
			end
			goTo(chest.Pos)
			task.wait(Cfg.UnverifiedDelay)
			return "unverified", "sem timer e sem valores para vigiar"
		end

		-- 4) coleta e confirma
		for attempt = 1, Cfg.ChestAttempts do
			if attempt > 1 then
				setStatus(("%s - try %d/%d"):format(text, attempt, Cfg.ChestAttempts))
			end

			if leftWorld() then
				return "left", "saiu do mundo"
			end
			rebase(watchers)
			goTo(chest.Pos)

			local outcome, note = waitForCollected(chest, timerLabel, watchers, Cfg.ChestTimeout)
			if outcome then
				task.wait(Cfg.ChestAfterDelay)
				return outcome, note
			end

			-- sem confirmacao: sobe um pouco e cai de volta no bau (re-dispara o toque) na proxima tentativa
			if attempt < Cfg.ChestAttempts then
				if leftWorld() then
					return "left", "saiu do mundo"
				end
				teleportTo(chest.Pos + Vector3.new(0, 10, 0))
				task.wait(Cfg.ChestRetryBounce)
			end
		end

		return "fail", "sem confirmacao (timer/recompensa)"
	end

	local function returnToStart(setStatus)
		if not (Cfg.ReturnToStartOnFinish and Chests.StartCFrame) then
			return
		end
		setStatus = setStatus or noop
		if Cfg.ReturnStartDelay > 0 then
			task.wait(Cfg.ReturnStartDelay)
		end
		if not waitForRoot() then
			return
		end

		local startCFrame = Chests.StartCFrame
		local startWorld = worldAt(startCFrame.Position)

		-- volta ao mundo de origem pelo caminho certo (Lobby -> Portal), nao direto
		if Cfg.ReturnToStartViaPortal and Worlds.current() ~= startWorld then
			if not Worlds.enter(startWorld, setStatus) then
				warn("[SettingsGui] nao confirmou a volta para " .. tostring(startWorld) .. "; teleportando direto")
			end
		end

		teleportCFrame(startCFrame)

		-- a ultima equipe equipada foi a do ultimo mundo visitado: volta para a do mundo onde voce estava
		if Cfg.EquipStartTeamOnFinish and startWorld then
			Teams.equipForWorld(startWorld)
		end
		Chests.StartCFrame = nil -- nao reaproveita uma posicao antiga numa proxima parada
	end

	local function collectAll(setStatus)
		local root = getRoot()
		Chests.StartCFrame = root and root.CFrame or nil
		Teams.LastSlot = nil

		local routes = buildRoutes()

		setStatus("Reading values...")
		local watchers = buildWatchers()

		local names = {}
		for _, watcher in ipairs(watchers) do
			table.insert(names, watcher.Name)
		end
		if #watchers > 0 then
			print(("[SettingsGui] Vigiando %d valor(es): %s"):format(#watchers, table.concat(names, ", ")))
		end

		local collected, onCooldown, unverified = 0, 0, 0
		local failed = {}

		for index, route in ipairs(routes) do
			local prefix = ("%s (%d/%d)"):format(route.World, index, #routes)

			-- mundo inteiro em cooldown (timers ja conhecidos): nem entra
			local allCooling = true
			for _, chest in ipairs(route.Chests) do
				if chestStatus(chest) ~= "cooldown" then
					allCooling = false
					break
				end
			end
			if allCooling then
				onCooldown += #route.Chests
				print(("[SettingsGui] %s: todos os baus em cooldown, mundo pulado"):format(route.World))
				continue
			end

			-- sempre comeca no Lobby (se a coleta comecou dentro de um mundo, ou um retorno falhou, volta antes)
			if not Worlds.ensureLobby(setStatus) then
				error("nao foi possivel voltar ao Lobby", 0)
			end

			-- entra no mundo e SO continua depois de confirmar que chegou la
			if route.Portal then
				setStatus(prefix .. ": Portal")
				if not Worlds.travel(route.Portal, route.World, setStatus, prefix .. ": Portal", Cfg.PortalDelay) then
					table.insert(failed, route.World .. " (portal)")
					warn("[SettingsGui] nao confirmou a entrada em " .. route.World .. "; mundo pulado")
					continue
				end
			end

			if Cfg.AutoEquipTeams then
				setStatus(prefix .. ": Team " .. tostring(Teams.slotForWorld(route.World)))
				Teams.equipForWorld(route.World)
			end

			local worldLost = false
			for _, chest in ipairs(route.Chests) do
				local text = prefix .. ": " .. chest.Name
				local result, note

				for _ = 1, 3 do
					-- se algo te tirou do mundo (ex.: morreu e renasceu no Lobby), volta a entrar ANTES de (re)tentar o bau
					if Worlds.current() ~= route.World then
						setStatus(text .. " - re-entering")
						if not Worlds.enter(route.World, setStatus) then
							worldLost = true
							break
						end
						if Cfg.AutoEquipTeams then
							Teams.LastSlot = nil
							Teams.equipForWorld(route.World)
						end
					end

					setStatus(text)
					result, note = collectChest(chest, watchers, setStatus, text, route.World)
					if result ~= "left" then
						break
					end
				end

				if worldLost then
					table.insert(failed, chest.Name)
					warn("[SettingsGui] saiu de " .. route.World .. " e nao conseguiu voltar; resto do mundo pulado")
					break
				end

				if result == "ok" then
					collected += 1
					print(("[SettingsGui] OK       %s (%s)"):format(chest.Name, note))
				elseif result == "cooldown" then
					onCooldown += 1
					print(("[SettingsGui] COOLDOWN %s (%s)"):format(chest.Name, note))
				elseif result == "unverified" then
					unverified += 1
					print(("[SettingsGui] ?        %s (%s)"):format(chest.Name, note))
				else
					table.insert(failed, chest.Name)
					warn(("[SettingsGui] FALHOU   %s (%s)"):format(chest.Name, note))
				end
			end

			-- volta ao Lobby e confere a chegada; se falhar, o inicio da proxima rota tenta de novo antes de qualquer bau
			if route.Return then
				setStatus(prefix .. ": Retorno Lobby")
				if not Worlds.travel(route.Return, "Lobby", setStatus, prefix .. ": Retorno Lobby", Cfg.ReturnDelay) then
					warn("[SettingsGui] nao confirmou o retorno ao Lobby de " .. route.World)
				end
			end
		end

		setStatus("Returning to start...")
		returnToStart(setStatus)

		local parts = { ("%d ok"):format(collected) }
		if onCooldown > 0 then
			table.insert(parts, onCooldown .. " cooldown")
		end
		if unverified > 0 then
			table.insert(parts, unverified .. " unverified")
		end
		if #failed > 0 then
			table.insert(parts, #failed .. " failed")
			warn("[SettingsGui] Baus sem confirmacao: " .. table.concat(failed, ", "))
		end
		local nextSecs = nextChestReady()
		if nextSecs then
			table.insert(parts, "next " .. fmtTime(nextSecs))
		end
		return table.concat(parts, " | ")
	end

	-- Inicia a coleta numa thread; onDone(resumo) quando termina (ou com o erro, se falhar)
	function Chests.start(setStatus, onDone)
		if Chests.Thread then
			return
		end
		Chests.Thread = spawnTask(function()
			local ok, result = pcall(collectAll, setStatus)
			Chests.Thread = nil
			onDone(ok and result or ("Erro: " .. tostring(result)))
		end)
		if coroutine.status(Chests.Thread) == "dead" then
			Chests.Thread = nil
		end
	end

	function Chests.stop()
		local wasRunning = Chests.Thread ~= nil
		if Chests.Thread then
			pcall(task.cancel, Chests.Thread)
			Chests.Thread = nil
		end
		if wasRunning then
			pcall(returnToStart) -- so volta se havia uma coleta em andamento
		end
	end

	-- usados pelo AutoCollect Chest
	Chests.nextReady = nextChestReady
	Chests.fmtTime = fmtTime

	-- Botao "Chest timers": mostra quando o proximo bau fica pronto e imprime os detalhes no F9
	function Chests.checkTimers()
		local counts = { cooldown = 0, ready = 0, unknown = 0 }
		local nextSecs, nextName

		for _, route in ipairs(buildRoutes()) do
			for _, chest in ipairs(route.Chests) do
				local status, secs = chestStatus(chest)
				counts[status] += 1
				if status == "cooldown" then
					print(("[SettingsGui] %-28s cooldown %s"):format(chest.Name, fmtTime(secs)))
					if not nextSecs or secs < nextSecs then
						nextSecs, nextName = secs, chest.Name
					end
				else
					print(("[SettingsGui] %-28s %s"):format(chest.Name, status))
				end
			end
		end

		-- diagnostico: texto cru dos timers carregados agora (bom para ver como fica um bau disponivel)
		for timerLabel in pairs(timerLabels) do
			if timerLabel:IsDescendantOf(workspace) then
				print(("[SettingsGui] timer %s | text=%q | shown=%s"):format(
					timerLabel:GetFullName(), timerLabel.Text, tostring(isShown(timerLabel))
				))
			end
		end

		local text
		if nextSecs then
			text = ("Next: %s in %s"):format(nextName, fmtTime(nextSecs))
		elseif counts.ready > 0 then
			text = ("%d chest(s) ready now"):format(counts.ready)
		else
			text = "No timers loaded yet"
		end
		if counts.unknown > 0 then
			text = text .. (" | %d unknown"):format(counts.unknown)
		end
		return text
	end
end

-- Blow Bubble: se a coleta de baus esta rodando, pausa (Coins/Gems subindo confundiria a verificacao)
local blowBubble = { Delay = Cfg.BlowBubbleDelay }

blowBubble.Loop = makeLoop(function()
	if Cfg.PauseBlowBubbleWhileCollecting and Chests.Thread then
		return
	end
	Net.fire("BlowBubble")
end, function()
	return blowBubble.Delay
end)

---------------------------------------------------------------------
-- LOGICA: ovos / Auto Hatch
---------------------------------------------------------------------
-- Selected = ovo escolhido | Names = ovos conhecidos (ordenados) | Stands = onde ficar ao abrir
-- World = mundo de cada ovo | Price = preco/moeda por unidade
local Eggs = {
	Selected = Cfg.DefaultEgg,
	Delay = Cfg.HatchDelay,
	Names = {},
	Stands = {},
	World = {},
	Price = {},
}

function Eggs.add(name)
	if table.find(Eggs.Names, name) then
		return false
	end
	table.insert(Eggs.Names, name)
	return true
end

function Eggs.isCrate(name)
	return type(name) == "string" and name:find("%s[Cc][Rr][Aa][Tt][Ee]$") ~= nil
end

-- ovos (" Egg") e caixas (" Crate") usam o mesmo remote (PurchaseEgg), mas sao coisas diferentes
function Eggs.isEgg(name)
	return type(name) == "string" and #name <= 40
		and (name:find("%s[Ee][Gg][Gg]$") ~= nil or Eggs.isCrate(name))
end

for _, world in ipairs(EGG_DATA) do
	for _, row in ipairs(world.Eggs) do
		Eggs.add(row[1])
		Eggs.Stands[row[1]] = row[2]
		Eggs.World[row[1]] = world.World
		Eggs.Price[row[1]] = row[3]
	end
end

-- ovos gravados pelo recorder (colados em EGG_SPOTS) sobrescrevem/complementam os de EGG_DATA
for name, pos in pairs(EGG_SPOTS) do
	if typeof(pos) == "Vector3" then
		Eggs.add(name)
		Eggs.Stands[name] = pos
		if not Eggs.World[name] then
			Eggs.World[name] = worldAt(pos)
		end
	end
end

Eggs.add(Cfg.DefaultEgg)

-- Ordem por preco: Coins -> Gems -> moeda do mundo; dentro de cada moeda, do mais barato ao mais caro.
-- Ovos sem preco conhecido (gravados pelo recorder) vao para o fim, em ordem alfabetica.
local CURRENCY_RANK = { coins = 1, gems = 2 } -- qualquer outra moeda ("other currency") = 3

function Eggs.priceKey(name)
	local digits, currency = (Eggs.Price[name] or ""):match("^([%d,]+)%s*(%a*)")
	local amount = digits and tonumber((digits:gsub(",", "")))
	if not amount then
		return 9, math.huge
	end
	return CURRENCY_RANK[currency:lower()] or 3, amount
end

function Eggs.sort()
	table.sort(Eggs.Names, function(a, b)
		local rankA, amountA = Eggs.priceKey(a)
		local rankB, amountB = Eggs.priceKey(b)
		if rankA ~= rankB then
			return rankA < rankB
		end
		if amountA ~= amountB then
			return amountA < amountB
		end
		return a < b
	end)
end

Eggs.sort()

do
	-- Se o ovo e de outro mundo: volta ao Lobby e entra pelo Portal do mundo do ovo (conferindo a chegada)
	local function enterWorldOf(egg)
		local targetTitle = Eggs.World[egg]
		if not (Cfg.HatchEnterWorld and targetTitle and getRoot()) then
			return
		end
		Worlds.enter(targetTitle, noop)
	end

	-- Se o servidor checar distancia ate o ovo, chega perto antes de comprar
	local function goToEgg(egg)
		local pos = Eggs.Stands[egg]
		local root = getRoot()
		if pos and root and (root.Position - pos).Magnitude > Cfg.HatchGoDistance then
			enterWorldOf(egg)
			teleportTo(pos)
			task.wait(0.5)
		end
	end

	-- Botoes de "Ovos teleportes": vai ate o lugar do ovo (passando pelo Retorno/Portal se for de outro mundo)
	function Eggs.goTo(egg)
		local pos = Eggs.Stands[egg]
		if not pos then
			return false
		end
		if Cfg.EggTeleportViaPortal then
			enterWorldOf(egg)
		end
		return teleportTo(pos)
	end

	Eggs.Loop = makeLoop(function()
		-- nao compra enquanto o "Collect all chests" esta teleportando
		if Chests.Thread then
			return
		end

		local egg = Eggs.Selected
		if Cfg.HatchGoToEgg then
			goToEgg(egg)
		end

		local ok, err = Net.fire("PurchaseEgg", egg, Cfg.HatchFlag)
		if debugEnabled then
			print(("[SettingsGui] PurchaseEgg %q %s -> %s"):format(egg, tostring(Cfg.HatchFlag), ok and "enviado" or tostring(err)))
		end
	end, function()
		return Eggs.Delay
	end)
end

---------------------------------------------------------------------
-- LOGICA: Egg recorder
---------------------------------------------------------------------
-- Quando voce abre um ovo, grava o nome, os argumentos, onde voce estava e tudo que achar do ovo,
-- e copia para a area de transferencia (bloco EGG_SPOTS para colar na config).
-- Deteccao: (1) hook no FireServer do NetworkRemoteEvent, se o executor tiver hookmetamethod;
--           (2) ProximityPrompt do ovo; (3) botao "Mark egg here" (manual).
-- Recorder.OnRecorded(nome) e Recorder.OnStatus(texto) sao preenchidos pela UI.
local Recorder = {
	Enabled = false,
	Busy = false,
	LastRemoteAt = 0,
	Records = {}, -- nome -> { Name, Stand, Lines, Count }
}

do
	-- o hook so e instalado uma vez por sessao (fica em _G para nao empilhar ao re-executar)
	local hookState = _G.SettingsGuiHookState
	if not hookState then
		hookState = { Installed = false, Handler = nil }
		_G.SettingsGuiHookState = hookState
	end

	local function setStatus(text)
		if Recorder.OnStatus then
			Recorder.OnStatus(text)
		end
	end

	local function fmtVector(v)
		return ("Vector3.new(%.4f, %.4f, %.4f)"):format(v.X, v.Y, v.Z)
	end

	local function fmtCFrame(cf)
		local parts = {}
		for _, n in ipairs({ cf:GetComponents() }) do
			table.insert(parts, ("%.4f"):format(n))
		end
		return "CFrame.new(" .. table.concat(parts, ", ") .. ")"
	end

	local function oneLine(text, maxLen)
		local s = tostring(text):gsub("%s+", " ")
		if #s > maxLen then
			s = s:sub(1, maxLen - 3) .. "..."
		end
		return s
	end

	local function fmtValue(v)
		local t = typeof(v)
		if t == "string" then
			return ("%q"):format(v)
		elseif t == "Instance" then
			return "<" .. v:GetFullName() .. ">"
		elseif t == "Vector3" then
			return fmtVector(v)
		elseif t == "table" then
			return "{...}"
		end
		return tostring(v)
	end

	-- Foto de todos os numeros do jogador para ver o que mudou ao abrir o ovo
	local function numericSnapshot()
		local snap = {}
		eachNumericValue(function(_, fullName, read)
			snap[fullName] = read()
		end)
		return snap
	end

	local function describeChanges(before, after)
		local changes = {}
		for key, old in pairs(before) do
			local new = after[key]
			if type(old) == "number" and type(new) == "number" and new ~= old then
				table.insert(changes, { Key = key, Old = old, New = new })
			end
		end
		table.sort(changes, function(a, b)
			return math.abs(a.New - a.Old) > math.abs(b.New - b.Old)
		end)

		local parts = {}
		for i = 1, math.min(#changes, 6) do
			local change = changes[i]
			local shortKey = change.Key:match("[^%.]+$") or change.Key
			local delta = change.New - change.Old
			table.insert(parts, ("%s %s%.0f (%.0f -> %.0f)"):format(
				shortKey, delta >= 0 and "+" or "", delta, change.Old, change.New
			))
		end
		if #parts == 0 then
			return "no numeric change detected"
		end
		return table.concat(parts, "; ")
	end

	local function eggObjectPosition(inst)
		if inst:IsA("Model") then
			return inst:GetPivot().Position
		elseif inst:IsA("BasePart") then
			return inst.Position
		end
		return nil
	end

	-- acha o objeto do ovo mais perto de voce (nome exato; se nao achar, qualquer " Egg"/" Crate")
	local function findEggInstance(name, origin)
		local exact, exactDist, any, anyDist

		local function consider(inst)
			if not (inst:IsA("Model") or inst:IsA("BasePart")) then
				return
			end
			local isExact = name ~= nil and inst.Name == name
			if not (isExact or Eggs.isEgg(inst.Name)) then
				return
			end
			local pos = eggObjectPosition(inst)
			if not pos then
				return
			end
			local d = (pos - origin).Magnitude
			if isExact then
				if not exactDist or d < exactDist then
					exact, exactDist = inst, d
				end
			elseif not anyDist or d < anyDist then
				any, anyDist = inst, d
			end
		end

		-- 1) busca barata: so o que esta perto de voce (sobe pela hierarquia de cada parte encontrada)
		for _, part in ipairs(workspace:GetPartBoundsInRadius(origin, Cfg.EggSearchRadius)) do
			local node = part
			while node and node ~= workspace do
				consider(node)
				node = node.Parent
			end
		end

		-- 2) nao achou: varre o Workspace inteiro (lento; cede a cada 4000 instancias)
		if not (exact or any) then
			for i, inst in ipairs(workspace:GetDescendants()) do
				consider(inst)
				if i % 4000 == 0 then
					task.wait()
				end
			end
		end

		return exact or any
	end

	-- tudo que da para ler do ovo: caminho, posicao, tamanho, atributos, prompts e textos (precos!)
	local function describeEggObject(inst, origin)
		local lines = {}
		local pos = eggObjectPosition(inst)

		table.insert(lines, ("egg object: %s (%s)"):format(inst:GetFullName(), inst.ClassName))
		if pos then
			table.insert(lines, ("object position: %s | %.1f studs from you"):format(fmtVector(pos), (pos - origin).Magnitude))
		end

		local size = inst:IsA("Model") and inst:GetExtentsSize() or inst.Size
		table.insert(lines, "object size: " .. fmtVector(size))

		local attrs = {}
		for key, value in pairs(inst:GetAttributes()) do
			table.insert(attrs, ("%s=%s"):format(key, oneLine(fmtValue(value), 40)))
		end
		table.sort(attrs)
		if #attrs > 0 then
			table.insert(lines, "object attributes: " .. table.concat(attrs, ", "))
		end

		local interactions, texts, childAttrs = {}, {}, {}
		for _, d in ipairs(inst:GetDescendants()) do
			if d:IsA("ProximityPrompt") then
				table.insert(interactions, ("ProximityPrompt %q/%q key=%s hold=%.1f range=%.1f"):format(
					d.ActionText, d.ObjectText, d.KeyboardKeyCode.Name, d.HoldDuration, d.MaxActivationDistance
				))
			elseif d:IsA("ClickDetector") then
				table.insert(interactions, ("ClickDetector range=%.1f"):format(d.MaxActivationDistance))
			elseif (d:IsA("TextLabel") or d:IsA("TextButton")) and d.Text ~= "" and #texts < 12 then
				table.insert(texts, ("%q"):format(oneLine(d.Text, 40)))
			end

			for key, value in pairs(d:GetAttributes()) do
				if #childAttrs < 12 then
					table.insert(childAttrs, ("%s.%s=%s"):format(d.Name, key, oneLine(fmtValue(value), 30)))
				end
			end
		end
		if #interactions > 0 then
			table.insert(lines, "interaction: " .. table.concat(interactions, " | "))
		end
		if #texts > 0 then
			table.insert(lines, "texts on the egg: " .. table.concat(texts, " | "))
		end
		if #childAttrs > 0 then
			table.insert(lines, "child attributes: " .. table.concat(childAttrs, ", "))
		end

		local children = {}
		for _, child in ipairs(inst:GetChildren()) do
			if #children < 12 then
				table.insert(children, ("%s (%s)"):format(child.Name, child.ClassName))
			end
		end
		if #children > 0 then
			table.insert(lines, "children: " .. table.concat(children, ", "))
		end

		return lines
	end

	-- bloco "local EGG_SPOTS = { ... }" com todos os ovos gravados (pronto para colar na config)
	function Recorder.snippet()
		local names = {}
		for name in pairs(Recorder.Records) do
			table.insert(names, name)
		end
		table.sort(names)

		local out = {
			"-- Egg spots gravados pelo recorder (cole no lugar de EGG_SPOTS, no topo do script)",
			"local EGG_SPOTS = {",
		}
		for _, name in ipairs(names) do
			local record = Recorder.Records[name]
			for _, line in ipairs(record.Lines) do
				table.insert(out, "\t-- " .. line)
			end
			table.insert(out, ("\t[%q] = %s,"):format(name, fmtVector(record.Stand)))
			table.insert(out, "")
		end
		table.insert(out, "}")
		return table.concat(out, "\n")
	end

	-- ovos que voce ja colou em EGG_SPOTS
	for name, pos in pairs(EGG_SPOTS) do
		if typeof(pos) == "Vector3" then
			Recorder.Records[name] = { Name = name, Stand = pos, Lines = { "(carregado de EGG_SPOTS)" }, Count = 0 }
		end
	end

	-- info = { Source = "remote"|"prompt"|"manual", Name = string?, Args = table.pack(...)? }
	function Recorder.record(info)
		local root = getRoot()
		if not root then
			setStatus("No character")
			return
		end

		local stand = root.Position
		local cframe = root.CFrame
		local name = info.Name

		-- mesmo ovo, mesmo lugar: so conta (nao repete a busca pesada)
		local existing = name and Recorder.Records[name]
		if existing and existing.Count > 0 and (existing.Stand - stand).Magnitude < 10 then
			existing.Count += 1
			setStatus(("%s opened x%d"):format(name, existing.Count))
			return
		end

		if Recorder.Busy then
			return
		end
		Recorder.Busy = true

		local ok, err = pcall(function()
			local before = numericSnapshot()
			local inst = findEggInstance(name, stand)
			name = name or (inst and inst.Name)
			if not name then
				setStatus("No egg found near you")
				return
			end

			task.wait(Cfg.EggCurrencyWait)
			local after = numericSnapshot()

			local lines = {}
			table.insert(lines, ("[%s] source: %s | PlaceId %d | JobId %s"):format(
				os.date("%Y-%m-%d %H:%M:%S"), info.Source, game.PlaceId, game.JobId ~= "" and game.JobId or "-"
			))

			if info.Args then
				local shown = {}
				for i = 1, info.Args.n do
					shown[i] = fmtValue(info.Args[i])
				end
				table.insert(lines, "FireServer args: " .. table.concat(shown, ", "))
			end

			table.insert(lines, "you stood at: " .. fmtVector(stand))
			table.insert(lines, "your cframe: " .. fmtCFrame(cframe))

			local spotLoc, spotGroup, spotDist = nearestSpot(stand)
			if spotLoc then
				table.insert(lines, ("nearest known spot: %s [%s], %.1f studs"):format(spotLoc.Name, spotGroup.Title, spotDist))
			end

			if inst then
				for _, line in ipairs(describeEggObject(inst, stand)) do
					table.insert(lines, line)
				end
			else
				table.insert(lines, "egg object: not loaded in Workspace")
			end

			table.insert(lines, ("changes in %.1fs: %s"):format(Cfg.EggCurrencyWait, describeChanges(before, after)))

			Recorder.Records[name] = { Name = name, Stand = stand, Lines = lines, Count = 1 }
			Eggs.Stands[name] = stand
			Eggs.World[name] = Eggs.World[name] or worldAt(stand)
			Eggs.add(name)
			Eggs.sort()

			local snippet = Recorder.snippet()
			local copied = copyText(snippet)
			print("[SettingsGui] ovo gravado:\n" .. snippet)
			setStatus(("%s saved%s"):format(name, copied and " + copied" or " (see F9)"))

			if Recorder.OnRecorded then
				pcall(Recorder.OnRecorded, name)
			end
		end)

		Recorder.Busy = false
		if not ok then
			warn("[SettingsGui] erro ao gravar ovo:", err)
			setStatus("Error (see F9)")
		end
	end

	-- chamado pelo hook com os argumentos do FireServer (sem o "self")
	local function onRemoteCall(...)
		if not Recorder.Enabled then
			return
		end
		local args = table.pack(...)
		if args[1] ~= "PurchaseEgg" then
			return
		end
		Recorder.LastRemoteAt = os.clock()
		local name = type(args[2]) == "string" and args[2] or nil
		spawnTask(Recorder.record, { Source = "remote", Name = name, Args = args })
	end

	-- Hook no __namecall: so repassa os argumentos do FireServer do NetworkRemoteEvent (o resto passa direto)
	local function installHook()
		if hookState.Installed then
			return true
		end
		if not (hookmetamethod and getnamecallmethod) then
			return false
		end

		local ok = pcall(function()
			local original
			local wrap = newcclosure or function(fn)
				return fn
			end
			original = hookmetamethod(game, "__namecall", wrap(function(...)
				if getnamecallmethod() == "FireServer" then
					local handler = hookState.Handler
					if handler then
						local self = ...
						if typeof(self) == "Instance" and self.Name == "NetworkRemoteEvent"
							and not (checkcaller and checkcaller()) then
							task.defer(handler, select(2, ...))
						end
					end
				end
				return original(...)
			end))
		end)

		hookState.Installed = ok
		return ok
	end

	-- Plano B (sem hook): ProximityPrompt do ovo
	connect(ProximityPromptService.PromptTriggered, function(prompt)
		if not Recorder.Enabled then
			return
		end

		local name
		local node = prompt
		while node and node ~= workspace do
			if Eggs.isEgg(node.Name) then
				name = node.Name
				break
			end
			node = node.Parent
		end
		if not name and Eggs.isEgg(prompt.ObjectText) then
			name = prompt.ObjectText
		end
		if not name then
			return
		end

		-- espera um pouco: se o hook pegar o FireServer, ele grava com os argumentos
		local startedAt = os.clock()
		delayTask(0.7, function()
			if Recorder.LastRemoteAt < startedAt then
				Recorder.record({ Source = "prompt", Name = name })
			end
		end)
	end)

	function Recorder.setEnabled(on)
		Recorder.Enabled = on
		if on then
			if Cfg.EggRecorderUseHook and installHook() then
				hookState.Handler = onRemoteCall
				setStatus("Hook active - open an egg")
			else
				hookState.Handler = nil
				setStatus("No hook - listening to egg prompts")
			end
		else
			hookState.Handler = nil
			setStatus("Recorder off")
		end
	end

	-- usado pelo Kill Code: o hook (se foi instalado) fica inerte
	function Recorder.release()
		hookState.Handler = nil
	end
end

---------------------------------------------------------------------
-- LOGICA: Rejoin / Server Hop
---------------------------------------------------------------------
-- Obs: precisa de HTTP (game:HttpGet ou request/http_request de executor) para listar servidores,
-- e o TeleportService nao funciona dentro do Roblox Studio (so no jogo real).
local Server = { Busy = false }

do
	local function httpGet(url)
		local ok, body = pcall(function()
			return game:HttpGet(url)
		end)
		if ok and type(body) == "string" and #body > 0 then
			return body
		end

		local req = (syn and syn.request) or http_request or request
		if req then
			local ok2, res = pcall(req, { Url = url, Method = "GET" })
			if ok2 and type(res) == "table" and res.Body then
				return res.Body
			end
		end
		return nil
	end

	-- sortOrder "Desc" = servidores mais cheios primeiro, "Asc" = mais vazios primeiro
	local function findServer(sortOrder, onlyEmptiest)
		local url = ("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=%s&excludeFullGames=true&limit=100")
			:format(game.PlaceId, sortOrder)

		local body = httpGet(url)
		if not body then
			return nil
		end

		local ok, data = pcall(function()
			return HttpService:JSONDecode(body)
		end)
		if not ok or type(data) ~= "table" or type(data.data) ~= "table" then
			return nil
		end

		local candidates = {}
		for _, server in ipairs(data.data) do
			if server.id ~= game.JobId
				and type(server.playing) == "number"
				and type(server.maxPlayers) == "number"
				and server.playing < server.maxPlayers then
				table.insert(candidates, server)
			end
		end
		if #candidates == 0 then
			return nil
		end

		-- nos mais vazios, sorteia entre os 5 primeiros (evita todo mundo cair no mesmo servidor)
		local limit = onlyEmptiest and math.min(#candidates, 5) or #candidates
		return candidates[math.random(1, limit)]
	end

	-- handle = retorno do addButton
	function Server.hop(handle, idleText, sortOrder, onlyEmptiest)
		if Server.Busy then
			return
		end
		Server.Busy = true
		handle.SetText("Wait...")

		local server = findServer(sortOrder, onlyEmptiest)
		if server then
			local ok = pcall(function()
				TeleportService:TeleportToPlaceInstance(game.PlaceId, server.id, player)
			end)
			if ok then
				-- se o teleporte falhar, libera o botao de novo depois de um tempo
				delayTask(10, function()
					Server.Busy = false
					handle.SetText(idleText)
				end)
				return
			end
		end

		handle.SetText("Failed")
		task.wait(2)
		handle.SetText(idleText)
		Server.Busy = false
	end

	function Server.rejoin(handle)
		if Server.Busy then
			return
		end
		Server.Busy = true
		handle.SetText("Wait...")

		local ok = pcall(function()
			if #Players:GetPlayers() <= 1 then
				-- sozinho no servidor: teleporta para o mesmo lugar (cai num servidor novo)
				TeleportService:Teleport(game.PlaceId, player)
			else
				TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, player)
			end
		end)

		if not ok then
			handle.SetText("Failed")
			task.wait(2)
		else
			task.wait(10)
		end
		handle.SetText("Rejoin")
		Server.Busy = false
	end
end

---------------------------------------------------------------------
-- LOGICA: Anti AFK
---------------------------------------------------------------------
-- O Roblox desconecta quem fica ~20 min sem nenhuma entrada. Quando o evento Idled dispara, respondemos com
-- um clique virtual (VirtualUser), que conta como atividade e evita o desconectar por inatividade.
-- Obs: isso cobre o kick por inatividade do proprio Roblox; um sistema de AFK proprio do jogo pode ser diferente.
local AntiAfk = { Connection = nil }

function AntiAfk.set(on)
	if on and not AntiAfk.Connection then
		AntiAfk.Connection = connect(player.Idled, function()
			local ok, err = pcall(function()
				local virtualUser = game:GetService("VirtualUser")
				virtualUser:CaptureController()
				virtualUser:ClickButton2(Vector2.new())
			end)
			if debugEnabled then
				print("[SettingsGui] Anti AFK:", ok and "clique virtual enviado" or tostring(err))
			end
		end)
	elseif not on and AntiAfk.Connection then
		AntiAfk.Connection:Disconnect()
		AntiAfk.Connection = nil
	end
end

---------------------------------------------------------------------
-- KILL CODE: desconecta tudo, cancela todas as threads e remove a GUI
---------------------------------------------------------------------
local function killCode()
	if not alive then
		return
	end
	alive = false

	for _, connection in ipairs(connections) do
		connection:Disconnect()
	end
	table.clear(connections)

	local current = coroutine.running()
	for _, thread in ipairs(threads) do
		if thread ~= current and coroutine.status(thread) ~= "dead" then
			pcall(task.cancel, thread)
		end
	end
	table.clear(threads)
	Chests.Thread = nil

	Recorder.release()
	player:SetAttribute("Debug", nil)
	if _G.SettingsGuiKill == killCode then
		_G.SettingsGuiKill = nil
	end
	gui:Destroy()
end

_G.SettingsGuiKill = killCode

