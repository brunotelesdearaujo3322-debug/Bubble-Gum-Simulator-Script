-- CONFIG
---------------------------------------------------------------------
local Cfg = {
	Title = "Settings",

	DefaultWalkSpeed = 16,
	DefaultJumpPower = 50,

	-- Auto Blow Bubble
	BlowBubbleDelay = 0.25, -- segundos entre disparos de "BlowBubble" (ajustavel no slider)
	PauseBlowBubbleWhileCollecting = true, -- evita falso positivo na confirmacao dos baus (Coins/Gems subindo)

	-- Auto Hatch: NetworkRemoteEvent:FireServer("PurchaseEgg", nomeDoOvo, HatchFlag)
	DefaultEgg = "Common Egg",
	HatchDelay = 1, -- segundos entre compras (ajustavel no slider)
	HatchFlag = true, -- 3o argumento do PurchaseEgg (no replay do remote spy era true)
	HatchGoToEgg = true, -- se o ovo tem lugar salvo, teleporta para perto antes de comprar
	HatchGoDistance = 30, -- so teleporta se estiver mais longe que isso (studs)
	HatchEnterWorld = true, -- se o ovo e de outro mundo, passa pelo Retorno/Portal antes

	-- Egg recorder
	EggRecorderUseHook = true, -- usa hookmetamethod (se o executor tiver) para ler o PurchaseEgg do jogo
	EggCurrencyWait = 1.5, -- segundos esperando Coins/Gems mudarem para calcular o custo
	EggSearchRadius = 60, -- busca barata do ovo perto de voce (studs); se falhar, varre o Workspace

	-- Equipes por mundo ao coletar baus: FireServer("EquipTeam", slot)
	AutoEquipTeams = true,
	LobbyTeam = 2, -- Mundo Spawn / Lobby
	DefaultWorldTeam = 3, -- Demais mundos
	SkyWorldTeam = 4, -- Mundo Céu
	EquipTeamDelay = 0.3, -- pausa curta apos equipar a equipe

	-- Posicao inicial ao iniciar "Collect all chests"
	ReturnToStartOnFinish = true,
	ReturnStartDelay = 0.5,
	EquipStartTeamOnFinish = true, -- ao voltar para a posicao inicial, equipa a equipe do mundo em que voce estava

	-- AutoCollect Chest: repete a coleta sozinho quando os baus ficam prontos
	AutoCollectMargin = 2, -- folga (s) depois do timer do proximo bau chegar a zero
	AutoCollectMinWait = 10, -- espera minima (s) entre uma coleta e outra
	AutoCollectMaxWait = 600, -- espera maxima (s); depois disso confere os baus de novo
	AutoCollectRetry = 60, -- espera (s) quando nenhum timer de bau e conhecido

	-- "Ovos teleportes": passa pelo Retorno/Portal ao ir para um ovo de outro mundo (igual ao Auto Hatch)
	EggTeleportViaPortal = true,

	-- Salvar Configuracao (precisa de writefile/readfile do executor)
	AutoLoadConfig = true, -- carrega a configuracao salva ao executar o script
	ConfigFile = "SettingsGui_%d.json", -- %d = GameId (cada jogo tem a sua)

	-- Portais e retorno ao Lobby: o SERVIDOR faz o teleporte, entao o script so continua depois que o
	-- personagem realmente chegou ao destino (confere a posicao: Lobby ou o mundo do portal).
	PortalArriveTimeout = 15, -- segundos esperando chegar ao destino em cada tentativa
	PortalAttempts = 3, -- tentativas (teleporta para o portal/retorno de novo se nao chegou)
	WorldSettleDelay = 2, -- folga depois de chegar (o mapa do mundo termina de carregar); use 10 para esperar sempre 10s
	PortalDelay = 10, -- se NAO der para confirmar a chegada: espera isso depois de entrar no Portal e confere de novo
	ReturnDelay = 10, -- idem depois do "Retorno Lobby"
	ReturnToStartViaPortal = true, -- ao voltar para a posicao inicial dentro de um mundo, passa pelo Lobby e pelo Portal

	-- Verificacao da recompensa dos baus: depois de teleportar, espera algum valor vigiado AUMENTAR
	-- (re-teleporte rapido: cada tentativa espera pouco e tenta de novo, sempre conferindo a coleta)
	ChestTimeout = 1.5, -- segundos esperando a recompensa em cada tentativa
	ChestAttempts = 5, -- tentativas por bau antes de pular para o proximo
	ChestRetryBounce = 0.15, -- pausa entre sair do bau e voltar nele (re-dispara o toque)
	ChestPoll = 0.05, -- de quanto em quanto tempo confere timer/recompensa
	ChestAfterDelay = 0.2, -- folga depois de confirmar a recompensa
	UnverifiedDelay = 2, -- espera por bau quando nao ha nenhum valor para vigiar
	CalibrateTime = 2, -- no inicio, ignora valores que mudam sozinhos (timers, renda passiva)

	-- Timers dos baus (Workspace...Chest.Regen.Info mostra "Next Chest in:\nHH:MM:SS")
	TimerMatchXZ = 20, -- distancia horizontal maxima (studs) entre o timer e o bau da lista
	TimerMatchY = 12, -- diferenca de altura maxima
	PreHover = 30, -- studs acima do bau: carrega a area e le o timer ANTES de coletar
	StreamWait = 1.5, -- segundos esperando o timer do bau carregar
	LabelSettle = 0.3, -- folga para o texto do timer atualizar antes de ler

	-- O que vigiar: numeros (IntValue/NumberValue/atributos) dentro de WatchRoots.
	-- WatchNames vazio = vigia todos; ou liste so os que importam
	WatchRoots = { player },
	WatchNames = { "Coins", "Gems" },
}

