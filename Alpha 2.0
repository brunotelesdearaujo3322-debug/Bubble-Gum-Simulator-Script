-- Arrastar a janela pelo cabecalho (sem deixar o cabecalho sair da tela)
local dragBar = create("Frame", {
	Name = "DragBar",
	BackgroundTransparency = 1,
	Size = UDim2.new(1, 0, 0, 58),
	Parent = window,
})

local drag = { Active = false }

dragBar.InputBegan:Connect(function(input)
	if isPointer(input) then
		drag.Active = true
		drag.Start = input.Position
		drag.StartPos = window.Position
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				drag.Active = false
			end
		end)
	end
end)

dragBar.InputChanged:Connect(function(input)
	if isMotion(input) then
		drag.Input = input
	end
end)

connect(UserInputService.InputChanged, function(input)
	if not (drag.Active and input == drag.Input) then
		return
	end

	-- tudo em pixels de tela; os offsets da janela valem "scale" vezes por causa do UIScale
	local s = uiScale.Scale
	local viewport = gui.AbsoluteSize
	local w, h = window.Size.X.Offset * s, window.Size.Y.Offset * s
	local maxX = viewport.X / 2 + w / 2 - 80 -- sempre sobram 80px da janela visiveis
	local minY = -viewport.Y / 2 + h / 2 -- o topo da janela nao sai da tela
	local maxY = viewport.Y / 2 + h / 2 - 50

	local x = math.clamp(drag.StartPos.X.Offset * s + (input.Position.X - drag.Start.X), -maxX, maxX)
	local y = math.clamp(drag.StartPos.Y.Offset * s + (input.Position.Y - drag.Start.Y), minY, maxY)
	window.Position = UDim2.new(drag.StartPos.X.Scale, x / s, drag.StartPos.Y.Scale, y / s)
end)

