		end)
	end
)

-- (a antiga secao "Camera" foi removida: o Field of View agora fica em Ferramentas)
local toolsGroup = addGroup(clientPage, "Ferramentas", { Open = false, Key = "cliente/tools" })

local startFov = workspace.CurrentCamera and math.round(workspace.CurrentCamera.FieldOfView) or 70

addSlider(toolsGroup.Body, "Field of View", "How wide your camera sees", 40, 120, startFov, function(v)
	local camera = workspace.CurrentCamera -- lido na hora: o jogo pode trocar a camera
	if camera then
		camera.FieldOfView = v
	end
end, nil, "tools.fov")

addToggle(toolsGroup.Body, "Debug", nil, false, function(on)
	debugEnabled = on
	player:SetAttribute("Debug", on)
	print("[SettingsGui] Debug:", on)
end, "tools.debug")

local copyPositionButton
copyPositionButton = addButton(toolsGroup.Body, "Copy Position", "Copies your current Vector3.new(...)", "Copy", function()
	local root = getRoot()
	if not root then
		return
	end

	local pos = root.Position
	local formatted = string.format("Vector3.new(%.4f, %.4f, %.4f)", pos.X, pos.Y, pos.Z)

	if copyText(formatted) then
		copyPositionButton.SetText("Copied!")
	else
		print("[SettingsGui] Position:", formatted)
		copyPositionButton.SetText("See F9")
	end

	delayTask(2, function()
		copyPositionButton.SetText("Copy")
	end)
end)

local serverGroup = addGroup(clientPage, "Servidor", { Open = false, Key = "cliente/server" })

local rejoinButton, hopButton, smallHopButton

rejoinButton = addButton(serverGroup.Body, "Rejoin", "Reconnects you to this server", "Rejoin", function()
	Server.rejoin(rejoinButton)
end)

hopButton = addButton(serverGroup.Body, "Server Hop", "Joins a different public server", "Hop", function()
	Server.hop(hopButton, "Hop", "Desc", false)
end)

smallHopButton = addButton(serverGroup.Body, "Small Server Hop", "Joins one of the emptiest servers", "Hop", function()
	Server.hop(smallHopButton, "Hop", "Asc", true)
end)

local scriptGroup = addGroup(clientPage, "Script", { Open = false, Key = "cliente/script" })

-- comeca ligado (script de farm fica AFK); a configuracao salva pode desligar
addToggle(scriptGroup.Body, "Anti AFK", "Prevents the idle disconnect while you are away", true, function(on)
	AntiAfk.set(on)
end, "script.antiafk")
AntiAfk.set(true)

local SAVE_DESC = "Saves your settings; loaded again on next run"
local saveButton
saveButton = addButton(scriptGroup.Body, "Salvar Configuração", SAVE_DESC, "Save", function()
	local ok, info = Settings.save()
	saveButton.SetText(ok and "Saved!" or "Failed")
	saveButton.SetDesc(ok and ("Saved to " .. info) or ("Could not save: " .. info))
	delayTask(3, function()
		saveButton.SetText("Save")
		saveButton.SetDesc(SAVE_DESC)
	end)
end)

local killButton = addButton(scriptGroup.Body, "Kill Code", "Stops everything and removes the GUI", "Kill", function()
	killCode()
end)
killButton.SetStyle(THEME.Close, THEME.CloseBorder) -- botao vermelho

---------------------------------------------------------------------
-- ABA: TELEPORT (um grupo por mundo: clique no nome do mundo para abrir/fechar)
---------------------------------------------------------------------
local teleportPage = newTab("Teleport")

addExpandControls(teleportPage)

for _, group in ipairs(TELEPORT_GROUPS) do
	local worldGroup = addGroup(
		teleportPage,
		("%s (%d)"):format(group.Title, #group.Locations),
		{ Key = "teleport/" .. group.Title } -- comeca fechado
	)
	for _, loc in ipairs(group.Locations) do
		addButton(worldGroup.Body, loc.Name, nil, "Go", function()
			teleportTo(loc.Pos)
		end)
	end
end

---------------------------------------------------------------------
-- ABRIR / FECHAR A JANELA
---------------------------------------------------------------------
local isOpen = false

local function fitScale()
	local viewport = gui.AbsoluteSize
	return math.clamp(math.min(viewport.X / 640, viewport.Y / 520), 0.5, 1)
end

local function setOpen(open)
	isOpen = open
	if open then
		uiScale.Scale = fitScale() * 0.6
		window.Visible = true
		TweenService:Create(uiScale, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
			Scale = fitScale(),
		}):Play()
	else
		local tween = TweenService:Create(uiScale, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Scale = fitScale() * 0.6,
		})
		tween.Completed:Connect(function()
			if not isOpen then
				window.Visible = false
			end
		end)
		tween:Play()
	end
end

openButton.Activated:Connect(function()
	setOpen(not isOpen)
end)

closeButton.Activated:Connect(function()
	setOpen(false)
end)

connect(gui:GetPropertyChangedSignal("AbsoluteSize"), function()
	if isOpen then
		uiScale.Scale = fitScale()
	end
end)

-- aplica a configuracao salva (se existir)
if Cfg.AutoLoadConfig and Settings.Data then
	local ok, err = pcall(Settings.apply)
	if not ok then
		warn("[SettingsGui] erro ao aplicar a configuracao salva:", err)
	end
end

mountGui(gui)
selectTab("Autofarm")
setOpen(true)
