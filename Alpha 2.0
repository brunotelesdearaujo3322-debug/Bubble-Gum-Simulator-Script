end)

local copySpotsButton
copySpotsButton = addButton(recorderGroup.Body, "Copy egg spots", "Copies every saved egg spot", "Copy", function()
	local snippet = Recorder.snippet()
	local copied = copyText(snippet)
	copySpotsButton.SetText(copied and "Copied!" or "See F9")
	if not copied then
		print(snippet)
	end
	delayTask(2, function()
		copySpotsButton.SetText("Copy")
	end)
end)

-- "Ovos teleportes": um grupo que abre/fecha com um subgrupo por mundo e um botao "Go" por ovo/caixa
local eggTeleportGroup = addGroup(eggPage, "Ovos teleportes", { Open = false, Key = "ovos/teleportes" })
local eggTeleportGroups = {}

-- lista de ovos: um grupo por mundo (ovos primeiro, depois as caixas), do mais barato ao mais caro
local eggGroups = {}
local eggButtons = {}

local function eggDesc(name)
	local parts = {}
	if Eggs.Price[name] then
		table.insert(parts, Eggs.Price[name])
	end
	if Eggs.Stands[name] then
		table.insert(parts, "spot saved")
	end
	if #parts == 0 then
		return nil
	end
	return table.concat(parts, " | ")
end

local function refreshEggButtons()
	for name, handle in pairs(eggButtons) do
		local selected = name == Eggs.Selected
		handle.SetText(selected and "Selected" or "Select")
		handle.SetStyle(
			selected and THEME.On or THEME.TabIdle,
			selected and THEME.OnBorder or THEME.PanelBorder
		)
	end

	local price = Eggs.Price[Eggs.Selected]
	setRowDesc(selectedRow, price and (Eggs.Selected .. " | " .. price) or Eggs.Selected)
end

-- ordem dos mundos (a mesma do Teleport; o que nao tem mundo vai em "Other")
local function eggWorldOrder()
	local order = {}
	for _, group in ipairs(TELEPORT_GROUPS) do
		table.insert(order, group.Title)
	end
	table.insert(order, "Other")
	return order
end

-- ovos e caixas de um mundo, na ordem de preco de Eggs.Names
local function eggsOfWorld(worldTitle)
	local eggs, crates = {}, {}
	for _, name in ipairs(Eggs.Names) do
		if (Eggs.World[name] or "Other") == worldTitle then
			table.insert(Eggs.isCrate(name) and crates or eggs, name)
		end
	end
	return eggs, crates
end

local function rebuildEggTeleports()
	for _, group in ipairs(eggTeleportGroups) do
		group.Destroy()
	end
	table.clear(eggTeleportGroups)

	for _, worldTitle in ipairs(eggWorldOrder()) do
		local eggs, crates = eggsOfWorld(worldTitle)
		local total = #eggs + #crates
		if total > 0 then
			local group = addGroup(
				eggTeleportGroup.Body,
				("%s (%d)"):format(worldTitle, total),
				{ Key = "ovos-tp/" .. worldTitle }
			)
			table.insert(eggTeleportGroups, group)

			local function addRows(names)
				for _, name in ipairs(names) do
					addButton(group.Body, name, Eggs.Price[name], "Go", function()
						Eggs.goTo(name)
					end)
				end
			end

			addRows(eggs)
			if #crates > 0 then
				addSection(group.Body, "Caixas")
				addRows(crates)
			end
		end
	end
end

-- recria as listas (depois de gravar um ovo); os grupos lembram se estavam abertos (pela Key)
local function rebuildEggList()
	for _, group in ipairs(eggGroups) do
		group.Destroy()
	end
	table.clear(eggGroups)
	table.clear(eggButtons)

	for _, worldTitle in ipairs(eggWorldOrder()) do
		local eggs, crates = eggsOfWorld(worldTitle)
		local total = #eggs + #crates
		if total > 0 then
			local group = addGroup(eggPage, ("%s (%d)"):format(worldTitle, total), { Key = "ovos/" .. worldTitle })
			table.insert(eggGroups, group)

			local function addRows(names)
				for _, name in ipairs(names) do
					eggButtons[name] = addButton(group.Body, name, eggDesc(name), "Select", function()
						Eggs.Selected = name
						refreshEggButtons()
					end)
				end
			end

			addRows(eggs)
			if #crates > 0 then
				addSection(group.Body, "Caixas")
				addRows(crates)
			end
		end
	end

	refreshEggButtons()
	rebuildEggTeleports()
end

Recorder.OnRecorded = function()
	rebuildEggList()
end

rebuildEggList()

-- o recorder comeca ligado (igual ao toggle)
Recorder.setEnabled(true)

---------------------------------------------------------------------
-- SALVAR CONFIGURACAO
---------------------------------------------------------------------
-- Grava os controles que tem "chave" (toggles/sliders), o ovo escolhido e quais grupos estao abertos.
-- Precisa de writefile/readfile (executor). Ao executar de novo, a configuracao e carregada sozinha
-- (Cfg.AutoLoadConfig) e aplicada no fim do script.
function Settings.collect()
	local data = { Version = 1, Controls = {}, Groups = {}, Egg = Eggs.Selected }
	for key, control in pairs(Settings.Controls) do
		data.Controls[key] = control.Handle.Get()
	end
	for key, open in pairs(groupOpenState) do
		data.Groups[key] = open
	end
	return data
end

-- retorna true, caminho  |  false, motivo
function Settings.save()
	if not Settings.supported() then
		return false, "executor sem writefile/readfile"
	end
	local path = Settings.path()
	local ok, err = pcall(function()
		writefile(path, HttpService:JSONEncode(Settings.collect()))
	end)
	if not ok then
		return false, tostring(err)
	end
	return true, path
end

-- aplica a configuracao carregada: ovo escolhido -> sliders -> toggles (assim os loops ja ligam com os valores certos)
function Settings.apply()
	local data = Settings.Data
	if type(data) ~= "table" or type(data.Controls) ~= "table" then
		return false
	end

	if type(data.Egg) == "string" and table.find(Eggs.Names, data.Egg) then
		Eggs.Selected = data.Egg
		refreshEggButtons()
	end

	for _, kind in ipairs({ "slider", "toggle" }) do
		for key, control in pairs(Settings.Controls) do
			local value = data.Controls[key]
			if control.Kind == kind and type(value) == (kind == "slider" and "number" or "boolean") then
				control.Handle.Set(value)
			end
		end
	end

	print("[SettingsGui] Configuracao carregada de " .. Settings.path())
	return true
end

