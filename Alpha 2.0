local gui = create("ScreenGui", {
	Name = "SettingsGui",
	ResetOnSpawn = false,
	IgnoreGuiInset = true,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
})

-- Funciona como LocalScript normal (PlayerGui) e em executores (gethui/CoreGui).
-- Se re-executar, remove a GUI antiga antes de montar a nova.
local function mountGui(screenGui)
	local hidden
	pcall(function()
		hidden = (gethui and gethui()) or game:GetService("CoreGui")
	end)

	for _, container in ipairs({ playerGui, hidden }) do
		local old = container and container:FindFirstChild(screenGui.Name)
		if old then
			old:Destroy()
		end
	end

	if hidden and pcall(function() screenGui.Parent = hidden end) then
		return
	end
	screenGui.Parent = playerGui
end

