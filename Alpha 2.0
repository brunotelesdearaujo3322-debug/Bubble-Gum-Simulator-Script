--[[
	SettingsGui.lua
	LocalScript -> coloque em StarterPlayer > StarterPlayerScripts (tambem roda em executores)

	GUI no estilo do print (painel azul, linhas claras, sliders/toggles verdes).
	Abas: Autofarm | Ovos | Cliente | Teleport
	As listas tem grupos que abrem e fecham: clique no titulo (ex.: "Atlantida")
	para mostrar/esconder o conteudo.

	Para adicionar coisas (parent = uma aba OU o .Body de um grupo):
		local grupo = addGroup(page, "Titulo", { Open = false, Key = "id-unico" })
		addSection(parent, "Titulo")
		addToggle(parent, "Nome", "descricao", valorInicial, function(on) end, "chave")
		addSlider(parent, "Nome", "descricao", min, max, valorInicial, function(v) end, passo, "chave")
		addButton(parent, "Nome", "descricao", "Texto do botao", function() end)
	Todos retornam um "handle" (Row, Set/Get, SetText/SetDesc/SetStyle...).
	A "chave" (opcional) faz o toggle/slider entrar no botao "Salvar Configuracao" (Cliente > Script):
	a configuracao e gravada em SettingsGui_<GameId>.json e carregada sozinha ao executar de novo.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ProximityPromptService = game:GetService("ProximityPromptService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local TeleportService = game:GetService("TeleportService")
local HttpService = game:GetService("HttpService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

