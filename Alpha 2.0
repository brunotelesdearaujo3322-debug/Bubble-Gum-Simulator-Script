local TELEPORT_GROUPS = {}
for _, raw in ipairs(TELEPORT_RAW) do
	local locations = {}
	for _, loc in ipairs(raw[2]) do
		table.insert(locations, { Name = loc[1], Pos = loc[2], Kind = loc[3] })
	end
	table.insert(TELEPORT_GROUPS, { Title = raw[1], Locations = locations })
end
TELEPORT_RAW = nil

---------------------------------------------------------------------
-- HELPERS
---------------------------------------------------------------------
-- Encerra a instancia anterior se o script for executado de novo
if _G.SettingsGuiKill then
	pcall(_G.SettingsGuiKill)
end

-- Controle de tudo que o script cria (conexoes e threads), para o "Kill Code" encerrar tudo
local alive = true
local connections = {}
local threads = {}

local function connect(signal, fn)
	local connection = signal:Connect(fn)
	table.insert(connections, connection)
	return connection
end

local function spawnTask(fn, ...)
	local thread = task.spawn(fn, ...)
	for i = #threads, 1, -1 do
		if coroutine.status(threads[i]) == "dead" then
			table.remove(threads, i)
		end
	end
	if coroutine.status(thread) ~= "dead" then
		table.insert(threads, thread)
	end
	return thread
end

local function delayTask(seconds, fn)
	return spawnTask(function()
		task.wait(seconds)
		fn()
	end)
end

local function create(className, props, children)
	local inst = Instance.new(className)
	local parent = props.Parent
	for key, value in pairs(props) do
		if key ~= "Parent" then
			inst[key] = value
		end
	end
	for _, child in ipairs(children or {}) do
		child.Parent = inst
	end
	inst.Parent = parent
	return inst
end

local function corner(radius)
	return create("UICorner", { CornerRadius = UDim.new(0, radius) })
end

local function pill()
	return create("UICorner", { CornerRadius = UDim.new(1, 0) })
end

-- borda (frames/botoes)
local function border(color, thickness)
	return create("UIStroke", {
		Color = color,
		Thickness = thickness,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

-- contorno de texto
local function textStroke(thickness, color)
	return create("UIStroke", {
		Color = color or THEME.Outline,
		Thickness = thickness,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
		LineJoinMode = Enum.LineJoinMode.Round,
	})
end

local function newLabel(props, strokeThickness)
	props.BackgroundTransparency = 1
	props.Font = THEME.Font
	props.TextColor3 = props.TextColor3 or Color3.new(1, 1, 1)
	return create("TextLabel", props, { textStroke(strokeThickness or 2) })
end

local function nextOrder(parent)
	local n = (parent:GetAttribute("Count") or 0) + 1
	parent:SetAttribute("Count", n)
	return n
end

local function isPointer(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch
end

local function isMotion(input)
	return input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch
end

local function copyText(text)
	local clip = setclipboard or toclipboard
	if clip then
		return (pcall(clip, text))
	end
	return false
end

-- Configuracao salva em arquivo (so funciona em executores com writefile/readfile/isfile).
-- Controls = toggles/sliders registrados com "chave"; Data = o que foi lido do arquivo ao iniciar.
local Settings = { Controls = {}, Data = nil }

function Settings.supported()
	return type(writefile) == "function" and type(readfile) == "function" and type(isfile) == "function"
end

function Settings.path()
	return Cfg.ConfigFile:format(game.GameId)
end

function Settings.read()
	if not Settings.supported() then
		return nil
	end
	local ok, data = pcall(function()
		local path = Settings.path()
		if not isfile(path) then
			return nil
		end
		return HttpService:JSONDecode(readfile(path))
	end)
	if ok and type(data) == "table" then
		return data
	end
	return nil
end

-- ponto conhecido (da lista do Teleport) mais perto de pos: diz em que mundo voce esta
-- retorna: local, grupo (mundo), distancia
local function nearestSpot(pos)
	local bestLoc, bestGroup, bestDist
	for _, group in ipairs(TELEPORT_GROUPS) do
		for _, loc in ipairs(group.Locations) do
			local d = (loc.Pos - pos).Magnitude
			if not bestDist or d < bestDist then
				bestLoc, bestGroup, bestDist = loc, group, d
			end
		end
	end
	return bestLoc, bestGroup, bestDist
end

local function noop() end

-- Em que mundo uma posicao esta ("Lobby", "Doce", ...)? Compara so X e Z (os baus do Lobby ficam a milhares
-- de studs de altura) com os pontos conhecidos. Os portais ficam fisicamente no Lobby, entao contam como Lobby.
local worldAnchors = {}
for _, group in ipairs(TELEPORT_GROUPS) do
	for _, loc in ipairs(group.Locations) do
		table.insert(worldAnchors, {
			World = loc.Kind == "portal" and "Lobby" or group.Title,
			X = loc.Pos.X,
			Z = loc.Pos.Z,
		})
	end
end

local function worldAt(pos)
	local best, bestDist
	for _, anchor in ipairs(worldAnchors) do
		local dx, dz = anchor.X - pos.X, anchor.Z - pos.Z
		local d = dx * dx + dz * dz
		if not bestDist or d < bestDist then
			best, bestDist = anchor.World, d
		end
	end
	return best
end

-- ponto de um mundo pelo tipo ("portal", "return", "spawn"...)
local function spotOf(worldTitle, kind)
	for _, group in ipairs(TELEPORT_GROUPS) do
		if group.Title == worldTitle then
			for _, loc in ipairs(group.Locations) do
				if loc.Kind == kind then
					return loc
				end
			end
		end
	end
	return nil
end

-- percorre os numeros vigiados (atributos + IntValue/NumberValue de Cfg.WatchRoots)
-- fn(nome, nomeCompleto, leitor)
local function eachNumericValue(fn)
	for _, root in ipairs(Cfg.WatchRoots) do
		for attrName, value in pairs(root:GetAttributes()) do
			if type(value) == "number" then
				fn(attrName, "attr " .. attrName, function()
					return root:GetAttribute(attrName)
				end)
			end
		end
		for _, inst in ipairs(root:GetDescendants()) do
			if (inst:IsA("IntValue") or inst:IsA("NumberValue")) and not inst:IsDescendantOf(playerGui) then
				fn(inst.Name, inst:GetFullName(), function()
					return inst.Value
				end)
			end
		end
	end
end

-- patinha decorativa do cabecalho
local function paw(parent, x, y, size, rotation)
	local holder = create("Frame", {
		Name = "Paw",
		BackgroundTransparency = 1,
		Position = UDim2.fromScale(x, y),
		Size = UDim2.fromOffset(size, size),
		Rotation = rotation,
		Parent = parent,
	})
	local function dot(px, py, s)
		create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(px, py),
			Size = UDim2.fromScale(s, s),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = 0.82,
			Parent = holder,
		}, { pill() })
	end
	dot(0.5, 0.66, 0.5)
	dot(0.14, 0.4, 0.22)
	dot(0.38, 0.16, 0.22)
	dot(0.62, 0.16, 0.22)
	dot(0.86, 0.4, 0.22)
end

